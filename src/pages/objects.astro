---
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Objects — Eduardo Turriza</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Space+Grotesk:wght@400;500;600&display=swap" rel="stylesheet" />
  <style>
    :root{
      --bg:#070b15;
      --panel:#111622;
      --panel-2:#0c111d;
      --line:rgba(151,203,232,.12);
      --text:#eef6ff;
      --muted:rgba(222,235,255,.58);
      --dim:rgba(222,235,255,.32);
      --cyan:#37c9ff;
      --green:#55e6a5;
      --pink:#ff64b4;
      --violet:#a879ff;
      --gold:#e3b943;
      --orange:#e79546;
      --blue:#6aa7ff;
    }

    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    html,body{width:100%;min-height:100%;background:var(--bg);color:var(--text);font-family:'JetBrains Mono',monospace}
    body{
      background:
        radial-gradient(circle at 18% 12%,rgba(55,201,255,.055),transparent 28%),
        radial-gradient(circle at 82% 76%,rgba(168,121,255,.045),transparent 26%),
        linear-gradient(180deg,#080c17,#050812 72%,#03050b);
      overflow-x:hidden;
    }

    body::before{
      content:"";
      position:fixed;
      inset:0;
      pointer-events:none;
      opacity:.18;
      background-image:
        radial-gradient(circle,rgba(255,255,255,.5) 0 1px,transparent 1.4px),
        radial-gradient(circle,rgba(55,201,255,.24) 0 1px,transparent 1.5px);
      background-size:140px 140px,211px 211px;
      background-position:0 0,54px 82px;
      mask-image:linear-gradient(180deg,black,transparent 80%);
    }

    header{
      position:sticky;
      top:0;
      z-index:10;
      height:58px;
      display:grid;
      grid-template-columns:1fr auto 1fr;
      align-items:center;
      padding:0 38px;
      border-bottom:1px solid var(--line);
      background:rgba(7,11,21,.76);
      backdrop-filter:blur(12px);
    }

    .brand{
      color:var(--cyan);
      font-weight:600;
      letter-spacing:.12em;
      font-size:13px;
      text-decoration:none;
      width:max-content;
    }

    nav{
      display:flex;
      gap:30px;
      justify-content:center;
    }

    nav a{
      color:rgba(222,235,255,.54);
      text-decoration:none;
      font-size:12px;
      letter-spacing:.04em;
      transition:color .18s,text-shadow .18s;
    }

    nav a:hover,
    nav a.active{
      color:#fff;
      text-shadow:0 0 14px rgba(55,201,255,.18);
    }

    .status{
      justify-self:end;
      display:flex;
      align-items:center;
      gap:8px;
      color:rgba(222,235,255,.58);
      font-size:11px;
      letter-spacing:.04em;
    }

    .status-dot{
      width:8px;
      height:8px;
      border-radius:50%;
      background:#58f59a;
      box-shadow:0 0 14px rgba(88,245,154,.48);
    }

    main{
      width:min(1320px,calc(100vw - 56px));
      margin:0 auto;
      padding:70px 0 90px;
    }

    .eyebrow{
      color:rgba(55,201,255,.58);
      font-size:11px;
      letter-spacing:.18em;
      margin-bottom:30px;
    }

    h1{
      font-family:'Space Grotesk',sans-serif;
      font-size:42px;
      line-height:1;
      font-weight:500;
      letter-spacing:-.02em;
      margin-bottom:22px;
    }

    .intro{
      color:var(--muted);
      max-width:720px;
      font-size:15px;
      line-height:1.75;
      margin-bottom:50px;
    }

    .grid{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:18px;
    }

    .card{
      min-height:278px;
      position:relative;
      display:flex;
      flex-direction:column;
      justify-content:space-between;
      border:1px solid var(--line);
      border-radius:12px;
      padding:28px 26px 22px;
      background:
        radial-gradient(circle at 100% 0%,var(--glow),transparent 32%),
        linear-gradient(180deg,rgba(255,255,255,.025),rgba(255,255,255,.008)),
        var(--panel);
      box-shadow:0 18px 50px rgba(0,0,0,.22), inset 0 1px rgba(255,255,255,.035);
      overflow:hidden;
    }

    .card::before{
      content:"";
      position:absolute;
      inset:0;
      pointer-events:none;
      border-radius:12px;
      background:linear-gradient(135deg,rgba(255,255,255,.045),transparent 18%,transparent 72%,rgba(255,255,255,.02));
      opacity:.75;
    }

    .card-head{
      position:relative;
      display:flex;
      justify-content:space-between;
      align-items:flex-start;
      gap:16px;
      margin-bottom:28px;
    }

    .code{
      color:var(--dim);
      font-size:11px;
      letter-spacing:.08em;
    }

    .type{
      border:1px solid currentColor;
      background:color-mix(in srgb,currentColor 16%,transparent);
      border-radius:999px;
      padding:4px 11px;
      font-size:10px;
      letter-spacing:.05em;
      white-space:nowrap;
    }

    .card h2{
      position:relative;
      font-family:'Space Grotesk',sans-serif;
      font-size:20px;
      font-weight:600;
      line-height:1.2;
      margin-bottom:34px;
    }

    .desc{
      position:relative;
      color:var(--muted);
      font-size:14px;
      line-height:1.75;
      margin-bottom:28px;
    }

    .tags{
      display:flex;
      flex-wrap:wrap;
      gap:7px;
      margin-bottom:22px;
    }

    .tag{
      background:rgba(255,255,255,.055);
      border:1px solid rgba(255,255,255,.07);
      color:rgba(222,235,255,.36);
      border-radius:5px;
      padding:4px 8px;
      font-size:10px;
    }

    .card-footer{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:16px;
      color:var(--dim);
      font-size:12px;
    }

    .repo{
      color:var(--accent);
      text-decoration:none;
      letter-spacing:.04em;
      transition:filter .18s,text-shadow .18s;
    }

    .repo:hover{
      filter:brightness(1.25);
      text-shadow:0 0 14px color-mix(in srgb,var(--accent) 45%,transparent);
    }

    .repo.hidden{
      visibility:hidden;
    }

    @media(max-width:1050px){
      .grid{grid-template-columns:repeat(2,1fr)}
      header{padding:0 22px}
    }

    @media(max-width:720px){
      header{grid-template-columns:1fr;gap:10px;height:auto;padding:18px 20px}
      nav{justify-content:flex-start;gap:18px;flex-wrap:wrap}
      .status{justify-self:start}
      main{width:calc(100vw - 32px);padding:44px 0 70px}
      .grid{grid-template-columns:1fr}
      h1{font-size:36px}
    }
  </style>
</head>
<body>
  <header>
    <a class="brand" href="../">ET — OBS/1</a>
    <nav aria-label="Navegación principal">
      <a class="active" href="./">objects</a>
      <a href="../log/">log</a>
      <a href="../about/">about</a>
    </nav>
    <div class="status"><span class="status-dot"></span>activo hoy</div>
  </header>

  <main>
    <div class="eyebrow">// catálogo de objetos</div>
    <h1>Proyectos</h1>
    <p class="intro">Cada proyecto es un objeto celeste. El tipo codifica su naturaleza.</p>

    <section class="grid">
      <article class="card" style="--accent:var(--cyan);--glow:rgba(55,201,255,.08)">
        <div>
          <div class="card-head">
            <span class="code">NGC-001</span>
            <span class="type" style="color:var(--cyan)">nebulosa</span>
          </div>
          <h2>gaiatools</h2>
          <p class="desc">Python library para queries y análisis del catálogo estelar ESA Gaia DR3. Incluye clustering con HDBSCAN, diagramas HR interactivos, crossmatching con NASA Exoplanet Archive, y CI/CD con GitHub Actions.</p>
          <div class="tags">
            <span class="tag">Python</span><span class="tag">PyPI</span><span class="tag">HDBSCAN</span><span class="tag">Plotly</span>
          </div>
        </div>
        <div class="card-footer">
          <span>2025</span>
          <a class="repo" href="https://github.com/ETurriza/gaiatools" target="_blank" rel="noopener noreferrer">ver repositorio →</a>
        </div>
      </article>

      <article class="card" style="--accent:var(--green);--glow:rgba(85,230,165,.08)">
        <div>
          <div class="card-head">
            <span class="code">NGC-002</span>
            <span class="type" style="color:var(--green)">satélite</span>
          </div>
          <h2>Robot bombero</h2>
          <p class="desc">Máquina de 4 estados implementada en AVR assembly puro para ATmega2560. Detecta llamas con fotoresistores, sigue líneas, identifica bases por color con sensor TCS230, y extingue fuego con bomba de agua vía servo.</p>
          <div class="tags">
            <span class="tag">AVR Assembly</span><span class="tag">ATmega2560</span><span class="tag">C</span>
          </div>
        </div>
        <div class="card-footer">
          <span>2024</span>
          <a class="repo" href="https://github.com/ETurriza/firefighter-robot" target="_blank" rel="noopener noreferrer">ver repositorio →</a>
        </div>
      </article>

      <article class="card" style="--accent:var(--pink);--glow:rgba(255,100,180,.08)">
        <div>
          <div class="card-head">
            <span class="code">NGC-004</span>
            <span class="type" style="color:var(--pink)">cúmulo</span>
          </div>
          <h2>DBSCAN paralelo</h2>
          <p class="desc">Implementación paralela del algoritmo DBSCAN en C++. Versión OpenMP logra 2.0x speedup sobre serial con 900k+ registros. Parte de un proyecto de cómputo paralelo con análisis de escalabilidad.</p>
          <div class="tags">
            <span class="tag">C++</span><span class="tag">OpenMP</span><span class="tag">MPI</span>
          </div>
        </div>
        <div class="card-footer">
          <span>2024</span>
          <a class="repo hidden" href="#">sin enlace</a>
        </div>
      </article>

      <article class="card" style="--accent:var(--blue);--glow:rgba(106,167,255,.08)">
        <div>
          <div class="card-head">
            <span class="code">NGC-007</span>
            <span class="type" style="color:var(--blue)">archivo relacional</span>
          </div>
          <h2>Bases de Datos</h2>
          <p class="desc">Proyecto final de Bases de Datos en el ITAM. Sistema para almacenar, administrar y analizar información del dataset de crímenes de Los Ángeles. Incluye limpieza de datos, normalización, creación de tablas, inserción mediante SQL y consultas estadísticas.</p>
          <div class="tags">
            <span class="tag">SQL</span><span class="tag">Normalización</span><span class="tag">Data Cleaning</span><span class="tag">LA Crime Data</span>
          </div>
        </div>
        <div class="card-footer">
          <span>2024</span>
          <a class="repo" href="https://github.com/Diego-FRM/Proyecto-Bases-de-Datos" target="_blank" rel="noopener noreferrer">ver repositorio →</a>
        </div>
      </article>

      <article class="card" style="--accent:var(--violet);--glow:rgba(168,121,255,.08)">
        <div>
          <div class="card-head">
            <span class="code">NGC-005</span>
            <span class="type" style="color:var(--violet)">señal débil</span>
          </div>
          <h2>U-Net denoising</h2>
          <p class="desc">Red convolucional tipo U-Net entrenada para eliminación de ruido en imágenes. Implementación desde cero en PyTorch con encoder-decoder simétrico y skip connections.</p>
          <div class="tags">
            <span class="tag">PyTorch</span><span class="tag">Python</span><span class="tag">CNN</span>
          </div>
        </div>
        <div class="card-footer">
          <span>2024</span>
          <a class="repo hidden" href="#">sin enlace</a>
        </div>
      </article>

      <article class="card" style="--accent:var(--violet);--glow:rgba(168,121,255,.08)">
        <div>
          <div class="card-head">
            <span class="code">NGC-006</span>
            <span class="type" style="color:var(--violet)">nebulosa en formación</span>
          </div>
          <h2>Braingeneers</h2>
          <p class="desc">Caracterización de redes neuronales emergentes usando deep learning aplicado a datos de electrofisiología. ISRP Program · UC Santa Cruz · verano 2026. En curso.</p>
          <div class="tags">
            <span class="tag">PyTorch</span><span class="tag">MNE-Python</span><span class="tag">AWS</span><span class="tag">Electrofisiología</span>
          </div>
        </div>
        <div class="card-footer">
          <span>2026</span>
          <a class="repo" href="https://braingeneers.ucsc.edu/" target="_blank" rel="noopener noreferrer">ver sitio web →</a>
        </div>
      </article>
    </section>
  </main>
</body>
</html>
