  sunMesh.material.toneMapped = false;
  sunMesh.position.copy(sunPos);
  scene.add(sunMesh);

  // Smooth solar glow using layered sprites instead of hard concentric shells.
  const solarCorona = new THREE.Sprite(new THREE.SpriteMaterial({
