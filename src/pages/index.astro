      tags:['Python','PyPI','HDBSCAN','Plotly'],
      desc:'Python library para ESA Gaia DR3. Publicado en PyPI con HDBSCAN clustering y visualizaciones interactivas.', noLink:false
    },
    {
      id:'NGC-002', name:'Robot bombero', type:'cuerpo rocoso', colorHex:'#d99a76',
      pos: new THREE.Vector3(-95, -34, -95), radius:10, hasRing:true,
      tex: T.mars, atmoColor: new THREE.Color(0xd99a76),
      roughness:0.96, bumpScale:0.16, terminatorStrength:0.42,
      tags:['AVR Assembly','ATmega2560','C'],
      desc:'Maquina de 4 estados en AVR assembly puro. Deteccion de llama y extincion autonoma.', noLink:false
    },
    {
      id:'NGC-003', name:'Braingeneers', type:'gigante gaseoso', colorHex:'#f2d1a3',
      pos: new THREE.Vector3(190, 58, -430), radius:22,
      tex: T.jupiter, atmoColor: new THREE.Color(0xffdfb0),
      hasClouds: true, roughness:0.72, cloudOpacity:0.1, bumpScale:0.0, terminatorStrength:0.28,
      tags:['PyTorch','MNE-Python','AWS'],
      desc:'Deep learning en redes neuronales emergentes. UC Santa Cruz - verano 2026.', noLink:true
    },
    {
      id:'NGC-004', name:'DBSCAN paralelo', type:'planeta anillado', colorHex:'#e4c397',
      pos: new THREE.Vector3(465, -16, -175), radius:11, hasSaturnRing:true,
      tex: T.saturn, atmoColor: new THREE.Color(0xeed8b8), ringTex: T.ring,
      roughness:0.8, bumpScale:0.0, terminatorStrength:0.34,
      tags:['C++','OpenMP','MPI'],
      desc:'Implementacion paralela de DBSCAN. 2x speedup con 900k+ registros.', noLink:false
    },
    {
      id:'NGC-005', name:'1er lugar LIDERA', type:'mundo volcanico', colorHex:'#e8b482',
      pos: new THREE.Vector3(735, 32, -20), radius:13,
      tex: T.venus, atmoColor: new THREE.Color(0xe1b27f),
      hasClouds: true, roughness:0.98, cloudOpacity:0.28, bumpScale:0.1, terminatorStrength:0.45,
      tags:['Robotica','Liderazgo','2022'],
      desc:'Lider del equipo Anahuac en premio LIDERA. 1er lugar nacional de robotica 2022.', noLink:true
    },
    {
      id:'NGC-006', name:'UPF Barcelona', type:'gigante helado', colorHex:'#a6ddd8',
      pos: new THREE.Vector3(980, -24, -360), radius:16,
      tex: T.uranus, atmoColor: new THREE.Color(0xa8e3df),
      hasClouds: true, hasSpecular: true, roughness:0.55, clearcoat:0.18, cloudOpacity:0.16, bumpScale:0.0,
      tags:['ML','Deep Learning','Erasmus'],
      desc:'Semestre de intercambio en Universitat Pompeu Fabra, Barcelona. Primavera 2024.', noLink:true
    },
  ];

  const planetMeshes = [];
  const discovered = new Set();

  function makePlanetMaterial(p) {
    const params = {
      map: p.tex,
      roughness: p.roughness ?? 0.82,
      metalness: 0.0,
    };
    if (p.bumpScale && p.bumpScale > 0) {
      params.bumpMap = p.tex;
      params.bumpScale = p.bumpScale;
    }
    if (p.hasSpecular) {
      params.clearcoat = p.clearcoat ?? 0.18;
      params.clearcoatRoughness = 0.62;
      params.reflectivity = 0.12;
    }
    return new THREE.MeshPhysicalMaterial(params);
  }

  function addMoon(parent, planetRadius, texture, distance, size, speed, tilt = 0) {
    const pivot = new THREE.Group();
    pivot.rotation.x = tilt;
    const moon = new THREE.Mesh(
      new THREE.SphereGeometry(size, 32, 32),
      new THREE.MeshStandardMaterial({ map: texture, roughness: 0.96, metalness: 0.0, bumpMap: texture, bumpScale: 0.04 })
    );
    moon.position.set(distance, 0, 0);
    moon.castShadow = true;
    moon.receiveShadow = true;
    moon.userData = { isMoon: true, spin: speed * 0.35 };
    pivot.userData = { isMoonPivot: true, speed };
    pivot.add(moon);
    const orbit = createOrbitLine(distance, 0x9fb4c2, 0.1);
    orbit.rotation.x = tilt;
    parent.add(orbit);
    parent.add(pivot);
    return pivot;
  }

  projects.forEach((p, index) => {
    const grp = new THREE.Group();
    grp.position.copy(p.pos);
    grp.rotation.z = [0.18,-0.08,0.06,0.25,-0.16,0.12][index] || 0;

    // Thin realistic halo. Kept subtle so it reads as atmosphere, not magic glow.
    const atmosphere = new THREE.Mesh(
      new THREE.SphereGeometry(p.radius * 1.075, 96, 96),
      new THREE.ShaderMaterial({
        vertexShader: atmoVert,
        fragmentShader: atmoFrag,
        uniforms: {
          uColor:    { value: p.atmoColor },
          uOpacity:  { value: p.hasClouds ? 0.48 : 0.32 },
          uPower:    { value: p.radius > 18 ? 2.4 : 2.9 },
          uDayBoost: { value: p.hasClouds ? 0.65 : 0.42 },
          uSunDir:   { value: sunPos.clone().normalize() },
        },
        transparent: true,
        side: THREE.BackSide,
        blending: THREE.AdditiveBlending,
        depthWrite: false,
      })
    );
    grp.add(atmosphere);

    const mat = makePlanetMaterial(p);
    const mesh = new THREE.Mesh(new THREE.SphereGeometry(p.radius, 128, 128), mat);
    mesh.userData = p;
    mesh.castShadow = true;
    mesh.receiveShadow = true;
    grp.add(mesh);
    planetMeshes.push(mesh);
    p.surface = mesh;

    // Adds a more convincing terminator on small planets whose texture can look flat.
    const nightShade = new THREE.Mesh(
      new THREE.SphereGeometry(p.radius * 1.003, 96, 96),
      new THREE.ShaderMaterial({
        vertexShader: terminatorVert,
        fragmentShader: terminatorFrag,
        uniforms: {
          uSunDir: { value: sunPos.clone().normalize() },
          uStrength: { value: p.terminatorStrength ?? 0.33 },
        },
        transparent: true,
        side: THREE.FrontSide,
        depthWrite: false,
      })
    );
    grp.add(nightShade);

    // Cloud layer: extremely thin, slow, transparent shell.
    if (p.hasClouds) {
      const cloudMat = new THREE.MeshPhysicalMaterial({
        map: T.clouds,
        transparent: true,
        opacity: p.cloudOpacity ?? 0.18,
        roughness: 1.0,
        metalness: 0.0,
        depthWrite: false,
      });
      const clouds = new THREE.Mesh(new THREE.SphereGeometry(p.radius * 1.018, 96, 96), cloudMat);
      clouds.castShadow = false;
      clouds.receiveShadow = false;
      clouds.userData = { isClouds: true, speed: 0.00055 + index * 0.00008 };
      grp.add(clouds);
      p.clouds = clouds;
    }

    // Realistic ring systems: textured Saturn rings when available, dusty ring otherwise.
    if (p.hasSaturnRing && p.ringTex) {
      [{ri:1.28, ro:1.88, op:0.82}, {ri:1.92, ro:2.48, op:0.56}, {ri:2.55, ro:3.15, op:0.28}].forEach(({ri,ro,op}) => {
        const rGeo = new THREE.RingGeometry(p.radius*ri, p.radius*ro, 256);
        const pos2 = rGeo.attributes.position;
        const uv2  = rGeo.attributes.uv;
        for (let i = 0; i < pos2.count; i++) {
          const rx = pos2.getX(i), ry = pos2.getY(i);
          const r2 = Math.sqrt(rx*rx + ry*ry);
          uv2.setXY(i, (r2 - p.radius*ri) / (p.radius*(ro-ri)), 0);
        }
        const ring = new THREE.Mesh(rGeo, new THREE.MeshBasicMaterial({
          map: p.ringTex,
          side: THREE.DoubleSide,
          transparent: true,
          opacity: op,
          blending: THREE.NormalBlending,
          depthWrite: false,
          fog: false,
        }));
        ring.rotation.x = Math.PI / 2.08;
        ring.rotation.z = 0.16;
        ring.userData = { isRing: true, speed: 0.00024 };
        grp.add(ring);
      });
    } else if (p.hasRing) {
      const ring = new THREE.Mesh(
        new THREE.RingGeometry(p.radius*1.75, p.radius*2.95, 192),
        new THREE.MeshBasicMaterial({
          color: 0xbda083,
          side: THREE.DoubleSide,
          transparent: true,
          opacity: 0.22,
          blending: THREE.NormalBlending,
          depthWrite: false,
          fog: false,
        })
      );
      ring.rotation.x = Math.PI/2.12;
      ring.rotation.z = -0.22;
      ring.userData = { isRing: true, speed: 0.00018 };
      grp.add(ring);
    }

    if (index === 0) addMoon(grp, p.radius, T.mars, p.radius * 3.1, p.radius * 0.22, 0.004, 0.18);
    if (index === 2) addMoon(grp, p.radius, T.venus, p.radius * 2.65, p.radius * 0.12, 0.003, -0.12);
    if (index === 5) addMoon(grp, p.radius, T.mars, p.radius * 2.5, p.radius * 0.16, 0.0038, 0.26);

    scene.add(grp);
    p.group = grp;
    p.spin = [0.0012,0.001,0.0018,0.0014,0.0009,0.0011][index];
  });

  // ── INPUT ──────────────────────────────────────────────────────────────
  const keys = {};
  const euler = new THREE.Euler(0,0,0,'YXZ');
  let isLocked = false, gameActive = false, bobPhase = 0;
  let lookedAt = null;

  document.addEventListener('keydown', e => {
    keys[e.key.toLowerCase()] = true;
    if (e.key.toLowerCase() === 'e' && lookedAt) { e.preventDefault(); openPopup(lookedAt); }
    if (['w','a','s','d','arrowup','arrowdown','arrowleft','arrowright',' '].includes(e.key.toLowerCase())) e.preventDefault();
  });
  document.addEventListener('keyup', e => { keys[e.key.toLowerCase()] = false; });
  renderer.domElement.addEventListener('click', () => { if (gameActive) renderer.domElement.requestPointerLock(); });
  document.addEventListener('pointerlockchange', () => {
    isLocked = document.pointerLockElement === renderer.domElement;
    document.getElementById('lock-hint').style.opacity = isLocked ? '0' : '0.4';
  });
  document.addEventListener('mousemove', e => {
    if (!isLocked || !gameActive) return;
    euler.y -= e.movementX * 0.002;
    euler.x -= e.movementY * 0.002;
    euler.x = Math.max(-Math.PI*.45, Math.min(Math.PI*.45, euler.x));
    camera.quaternion.setFromEuler(euler);
  });

  // ── RAYCASTER ──────────────────────────────────────────────────────────
  const raycaster = new THREE.Raycaster();
  const center = new THREE.Vector2(0, 0);

  function checkLookAt() {
    raycaster.setFromCamera(center, camera);
    const hits = raycaster.intersectObjects(planetMeshes);
    lookedAt = hits.length > 0 ? hits[0].object.userData : null;
    const tgt = document.getElementById('tgt');
    const xring = document.getElementById('xring');
    if (lookedAt) {
      document.getElementById('tname').textContent = lookedAt.name;
      document.getElementById('tid').textContent = lookedAt.id + ' - ' + lookedAt.type.toUpperCase();
      tgt.style.opacity = '1';
      xring.classList.add('active');
      if (!discovered.has(lookedAt.id)) {
        discovered.add(lookedAt.id);
        document.getElementById('hobj').textContent = discovered.size + ' / 6';
        showDiscoveryFeedback(lookedAt);
      } else {
        document.getElementById('hobj').textContent = discovered.size + ' / 6';
      }
    } else {
      tgt.style.opacity = '0';
      xring.classList.remove('active');
    }
  }

  function showDiscoveryFeedback(obj) {
    const toast = document.getElementById('discovery-toast');
    const name = document.getElementById('discovery-name');
    if (!toast || !name) return;

    name.textContent = obj.id + ' · ' + obj.name.toUpperCase();
    toast.classList.add('on');
    xring.classList.add('active');
    playDiscoverySound();

    clearTimeout(showDiscoveryFeedback._timer);
    showDiscoveryFeedback._timer = setTimeout(() => {
      toast.classList.remove('on');
    }, 2200);
  }

  // ── POPUP ──────────────────────────────────────────────────────────────
  let activePopup = null;
  function closePopup() { document.querySelector('.popup')?.remove(); activePopup = null; }
  function openPopup(obj) {
    closePopup(); activePopup = obj; document.exitPointerLock();
    const el = document.createElement('div');
    el.className = 'popup';
    el.style.cssText = 'top:50%;left:50%;transform:translate(-50%,-50%)';
    el.innerHTML =
      '<button class="p-close" id="pclose">X</button>' +
      '<div class="p-id">' + obj.id + '</div>' +
      '<div class="p-name">' + obj.name + '</div>' +
      '<span class="p-type" style="color:'+obj.colorHex+';background:'+obj.colorHex+'18;border-color:'+obj.colorHex+'40">'+obj.type+'</span>' +
      '<div class="p-desc">' + obj.desc + '</div>' +
      '<div class="p-tags">' + obj.tags.map(t => '<span class="p-tag">'+t+'</span>').join('') + '</div>' +
      (!obj.noLink ? '<button class="p-btn" style="color:'+obj.colorHex+';border-color:'+obj.colorHex+'50">ver en GitHub</button>' : '');
    document.getElementById('container').appendChild(el);
    document.getElementById('pclose').addEventListener('click', closePopup);
  }

  // ── MOVEMENT ───────────────────────────────────────────────────────────
  function updateMovement(dt) {
    const spd = 34, fy = euler.y;
    const fwd   = new THREE.Vector3(-Math.sin(fy), 0, -Math.cos(fy));
    const right = new THREE.Vector3( Math.cos(fy), 0, -Math.sin(fy));
    const up    = new THREE.Vector3(0, 1, 0);
    let moving = false;
    if (tourActive && (keys['w']||keys['a']||keys['s']||keys['d']||keys['arrowup']||keys['arrowdown']||keys['arrowleft']||keys['arrowright']||keys[' ']||keys['shift'])) setTourActive(false);
    if (keys['w']||keys['arrowup'])    { camera.position.addScaledVector(fwd,    spd*dt); moving=true; }
    if (keys['s']||keys['arrowdown'])  { camera.position.addScaledVector(fwd,   -spd*dt); moving=true; }
    if (keys['a']||keys['arrowleft'])  { camera.position.addScaledVector(right, -spd*dt); moving=true; }
    if (keys['d']||keys['arrowright']) { camera.position.addScaledVector(right,  spd*dt); moving=true; }
    if (keys[' '])                     { camera.position.addScaledVector(up,     spd*dt); moving=true; }
    if (keys['shift'])                 { camera.position.addScaledVector(up,    -spd*dt); moving=true; }
    if (moving) bobPhase += dt * 3.5;
    if (!keys[' '] && !keys['shift']) camera.position.y += moving ? Math.sin(bobPhase)*0.18 : 0;
    document.getElementById('sbfill').style.width = (moving ? 80 : 0) + '%';
    document.getElementById('hpos').textContent = 'X:'+camera.position.x.toFixed(0)+' Y:'+camera.position.y.toFixed(0)+' Z:'+camera.position.z.toFixed(0);
  }

  function setTourActive(active) {
    tourActive = active;
    tourTarget = null;
    tourTransition = null;
    tourHold = 0;

    const btn = document.getElementById('tour-btn');
    if (btn) {
      btn.classList.toggle('active', active);
      btn.textContent = active ? 'DETENER TOUR' : 'INICIAR TOUR';
    }

    if (active) {
      currentTourIndex = 0;
      startTourTransition();
      playTourStepSound();
      document.exitPointerLock?.();
    }
  }

  function getTourCameraPose(project) {
    const target = project.group.position.clone();
    const offset = new THREE.Vector3(
      project.radius * 4.4,
      project.radius * 1.25 + 8,
      project.radius * 5.2
    );
    const pos = target.clone().add(offset);
    return { pos, target };
  }

  function startTourTransition() {
    if (!projects.length) return;
    const project = projects[currentTourIndex % projects.length];
    const pose = getTourCameraPose(project);

    tourTarget = project;
    tourTransition = {
      fromPos: camera.position.clone(),
      toPos: pose.pos,
      fromQuat: camera.quaternion.clone(),
      toQuat: new THREE.Quaternion(),
      elapsed: 0,
      duration: 3.8,
      target: pose.target,
    };

    const lookMatrix = new THREE.Matrix4();
    lookMatrix.lookAt(pose.pos, pose.target, new THREE.Vector3(0,1,0));
    tourTransition.toQuat.setFromRotationMatrix(lookMatrix);

    showDiscoveryFeedback(project);
  }

  function updateAutoTour(dt) {
    if (!tourActive) return;

    if (tourTransition) {
      tourTransition.elapsed += dt;
      const t = Math.min(1, tourTransition.elapsed / tourTransition.duration);
      const ease = t < 0.5 ? 2*t*t : 1 - Math.pow(-2*t + 2, 2) / 2;

      camera.position.lerpVectors(tourTransition.fromPos, tourTransition.toPos, ease);
      camera.quaternion.slerpQuaternions(tourTransition.fromQuat, tourTransition.toQuat, ease);

      document.getElementById('sbfill').style.width = '35%';
      document.getElementById('hpos').textContent = 'X:'+camera.position.x.toFixed(0)+' Y:'+camera.position.y.toFixed(0)+' Z:'+camera.position.z.toFixed(0);

      if (t >= 1) {
        tourTransition = null;
        tourHold = 4.2;
      }
      return;
    }

    if (tourTarget) {
      const target = tourTarget.group.position.clone();
      const lookMatrix = new THREE.Matrix4();
      lookMatrix.lookAt(camera.position, target, new THREE.Vector3(0,1,0));
      const q = new THREE.Quaternion().setFromRotationMatrix(lookMatrix);
      camera.quaternion.slerp(q, 0.035);
    }

    tourHold -= dt;
    if (tourHold <= 0) {
      currentTourIndex = (currentTourIndex + 1) % projects.length;
      startTourTransition();
      playTourStepSound();
    }
  }

  // ── SUBTLE SPACECRAFT EASTER EGGS ─────────────────────────────────────
  const transientCrafts = [];

  function makeGlowSprite(color = 0x9fd7ff, size = 4.5, opacity = 0.24) {
    const glow = new THREE.Sprite(new THREE.SpriteMaterial({
      map: flareSprite,
      color,
      transparent: true,
      opacity,
      blending: THREE.AdditiveBlending,
      depthWrite: false,
      fog: false,
    }));
    glow.scale.set(size, size, 1);
    return glow;
  }

  function createProbeCraft() {
    const g = new THREE.Group();
    const bus = new THREE.Mesh(
      new THREE.BoxGeometry(3.4, 2.1, 2.6),
      new THREE.MeshStandardMaterial({ color:0x9da8ad, roughness:0.48, metalness:0.28 })
    );
    g.add(bus);

    const dish = new THREE.Mesh(
      new THREE.SphereGeometry(2.0, 20, 10, 0, Math.PI*2, 0, Math.PI/2),
      new THREE.MeshStandardMaterial({ color:0xb9c2c8, roughness:0.55, metalness:0.42 })
    );
    dish.position.set(0, 1.65, 0);
    dish.scale.set(1.15, .38, 1.15);
    g.add(dish);

    const panelMat = new THREE.MeshStandardMaterial({ color:0x152033, roughness:0.42, metalness:0.16 });
    const p1 = new THREE.Mesh(new THREE.BoxGeometry(8.5,.06,2.6), panelMat);
    p1.position.x = -6.3;
    g.add(p1);
    const p2 = p1.clone();
    p2.position.x = 6.3;
    g.add(p2);

    const glow = makeGlowSprite(0x9fd7ff, 4.5, 0.18);
    glow.position.set(0, 0, -2.9);
    g.add(glow);

    g.userData.label = 'deep-space probe';
    return g;
  }

  function createFalconInspiredCraft() {
    const g = new THREE.Group();
    const hullMat = new THREE.MeshStandardMaterial({ color:0xb8b3aa, roughness:0.86, metalness:0.18 });
    const darkMat = new THREE.MeshStandardMaterial({ color:0x5c626b, roughness:0.74, metalness:0.22 });

    const body = new THREE.Mesh(new THREE.CylinderGeometry(4.3, 4.9, 1.25, 36), hullMat);
    body.rotation.x = Math.PI / 2;
    g.add(body);

    const offsetDome = new THREE.Mesh(new THREE.SphereGeometry(1.45, 20, 12), darkMat);
    offsetDome.scale.set(1.05, .28, 1.05);
    offsetDome.position.set(-0.7, .58, 0);
    g.add(offsetDome);

    const mandibleGeo = new THREE.BoxGeometry(3.8, .55, 1.1);
    const mandible1 = new THREE.Mesh(mandibleGeo, hullMat);
    mandible1.position.set(3.9, 0, 1.15);
    g.add(mandible1);
    const mandible2 = mandible1.clone();
    mandible2.position.z = -1.15;
    g.add(mandible2);

    const cockpit = new THREE.Mesh(
      new THREE.CylinderGeometry(.44, .44, 3.3, 14),
      new THREE.MeshStandardMaterial({ color:0x95aebe, roughness:0.42, metalness:0.18 })
    );
    cockpit.rotation.z = Math.PI / 2;
    cockpit.position.set(3.8, .32, -2.9);
    g.add(cockpit);

    const engine = makeGlowSprite(0x75bdff, 6.4, 0.23);
    engine.scale.set(6.2, 2.4, 1);
    engine.position.set(-4.7, 0, 0);
    g.add(engine);

    g.userData.label = 'freighter legend';
    return g;
  }

  function createDiscoveryInspiredCraft() {
    const g = new THREE.Group();
    const whiteMat = new THREE.MeshStandardMaterial({ color:0xd6d8dc, roughness:0.78, metalness:0.13 });
    const darkMat = new THREE.MeshStandardMaterial({ color:0x626a73, roughness:0.62, metalness:0.24 });

    const pod = new THREE.Mesh(new THREE.SphereGeometry(1.25, 20, 20), whiteMat);
    pod.position.x = 7.8;
    g.add(pod);

    const spine = new THREE.Mesh(new THREE.CylinderGeometry(.1, .1, 17, 10), darkMat);
    spine.rotation.z = Math.PI / 2;
    g.add(spine);

    const module = new THREE.Mesh(new THREE.CylinderGeometry(.65, .65, 3.4, 20), whiteMat);
    module.rotation.z = Math.PI / 2;
    module.position.x = 1.2;
    g.add(module);

    const engine = new THREE.Mesh(new THREE.SphereGeometry(1.9, 20, 20), darkMat);
    engine.position.x = -7.2;
    g.add(engine);

    const glow = makeGlowSprite(0x9ac7ff, 4.2, 0.16);
    glow.position.set(-9.4, 0, 0);
    g.add(glow);

    g.userData.label = 'odyssey vessel';
    return g;
  }

  function createEnduranceInspiredCraft() {
    const g = new THREE.Group();
    const mat = new THREE.MeshStandardMaterial({ color:0xcfd5d9, roughness:0.82, metalness:0.16 });

    const hub = new THREE.Mesh(new THREE.CylinderGeometry(.55, .55, .5, 18), mat);
    hub.rotation.x = Math.PI / 2;
    g.add(hub);

    for (let i = 0; i < 12; i++) {
      const a = (i / 12) * Math.PI * 2;

      const arm = new THREE.Mesh(new THREE.BoxGeometry(4.1, .09, .22), mat);
      arm.rotation.z = a;
      arm.position.set(Math.cos(a) * 2.0, Math.sin(a) * 2.0, 0);
      g.add(arm);

      const module = new THREE.Mesh(new THREE.BoxGeometry(1.15, .23, .42), mat);
      module.rotation.z = a;
      module.position.set(Math.cos(a) * 4.1, Math.sin(a) * 4.1, 0);
      g.add(module);
    }

    g.rotation.y = Math.PI / 2;
    g.userData.label = 'endurance ring';
    return g;
  }

  const craftTypes = [
    { make: createProbeCraft, speed: 0.52, bob: 0.035, rotY: 0.008, rotZ: 0.0, scale: [0.9, 1.1] },
    { make: createFalconInspiredCraft, speed: 0.68, bob: 0.04, rotY: 0.01, rotZ: 0.002, scale: [0.78, 0.95] },
    { make: createDiscoveryInspiredCraft, speed: 0.55, bob: 0.025, rotY: 0.006, rotZ: 0.001, scale: [0.82, 1.0] },
    { make: createEnduranceInspiredCraft, speed: 0.5, bob: 0.02, rotY: 0.006, rotZ: 0.012, scale: [0.85, 1.05] },
  ];

  function showFlybyAlert(label) {
    const alert = document.getElementById('flyby-alert');
    if (!alert) return;
    alert.textContent = 'CONTACTO VISUAL · ' + label.toUpperCase();
    alert.style.opacity = '1';
    alert.style.color = 'rgba(223,244,255,.55)';
    setTimeout(() => {
      alert.style.opacity = '0';
      alert.style.color = 'rgba(223,244,255,0)';
    }, 2200);
  }

  function placeCraftFacingVelocity(mesh, direction) {
    mesh.quaternion.setFromUnitVectors(new THREE.Vector3(1,0,0), direction.clone().normalize());
    mesh.rotateZ(-0.02);
  }

  function spawnDistantCraft() {
    if (!gameActive || transientCrafts.length > 2) return;

    const def = craftTypes[Math.floor(Math.random() * craftTypes.length)];
    const mesh = def.make();
    const scale = def.scale[0] + Math.random() * (def.scale[1] - def.scale[0]);
    mesh.scale.setScalar(scale);

    mesh.position.set(
      camera.position.x - 300,
      camera.position.y + 28 + Math.random() * 42,
      camera.position.z - 160 - Math.random() * 160
    );

    const dir = new THREE.Vector3(1, 0.02, 0.04).normalize();
    placeCraftFacingVelocity(mesh, dir);
    scene.add(mesh);

    transientCrafts.push({
      mesh,
      mode: 'distant',
      phase: Math.random() * Math.PI * 2,
      vx: def.speed,
      bob: def.bob,
      rotY: def.rotY,
      rotZ: def.rotZ,
      maxX: camera.position.x + 360,
    });
  }

  function spawnCinematicFlyby() {
    if (!gameActive || transientCrafts.length > 3) return;

    const def = craftTypes[1 + Math.floor(Math.random() * (craftTypes.length - 1))];
    const mesh = def.make();

    const forward = new THREE.Vector3();
    camera.getWorldDirection(forward);
    const right = new THREE.Vector3().crossVectors(forward, new THREE.Vector3(0,1,0)).normalize();
    const up = new THREE.Vector3(0,1,0);
    const side = Math.random() > 0.5 ? 1 : -1;

    // Mantener el flyby lejos de la cámara para no tapar la escena.
    const start = camera.position.clone()
      .addScaledVector(forward, 125 + Math.random() * 60)
      .addScaledVector(right, side * (135 + Math.random() * 45))
      .addScaledVector(up, 28 + Math.random() * 28);

    const end = camera.position.clone()
      .addScaledVector(forward, 230 + Math.random() * 90)
      .addScaledVector(right, -side * (145 + Math.random() * 55))
      .addScaledVector(up, -8 + Math.random() * 22);

    const scale = 0.78 + Math.random() * 0.22;
    mesh.scale.setScalar(scale);
    mesh.position.copy(start);

    const direction = end.clone().sub(start).normalize();
    placeCraftFacingVelocity(mesh, direction);
    scene.add(mesh);

    transientCrafts.push({
      mesh,
      mode: 'flyby',
      phase: Math.random() * Math.PI * 2,
      age: 0,
      life: 6.8 + Math.random() * 1.8,
      start,
      end,
      bob: def.bob * 0.55,
      rotY: def.rotY * 0.45,
      rotZ: def.rotZ * 0.55,
    });

    showFlybyAlert(mesh.userData.label || 'unknown craft');
  }

  setInterval(spawnDistantCraft, 30000);
  setInterval(spawnCinematicFlyby, 48000);

  function updateTransientCrafts(dt) {
    for (let i = transientCrafts.length - 1; i >= 0; i--) {
      const craft = transientCrafts[i];
      craft.phase += dt * 1.2;

      if (craft.mode === 'flyby') {
        craft.age += dt;
        const t = Math.min(1, craft.age / craft.life);
        const ease = t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
        craft.mesh.position.lerpVectors(craft.start, craft.end, ease);
        craft.mesh.position.y += Math.sin(craft.phase * 1.8) * craft.bob;
        craft.mesh.rotation.y += craft.rotY;
        craft.mesh.rotation.z += craft.rotZ;

        if (t >= 1) {
          scene.remove(craft.mesh);
          transientCrafts.splice(i, 1);
        }
        continue;
      }

      craft.mesh.position.x += craft.vx;
      craft.mesh.position.y += Math.sin(craft.phase) * craft.bob;
      craft.mesh.rotation.y += craft.rotY;
      craft.mesh.rotation.z += craft.rotZ;

      if (craft.mesh.position.x > craft.maxX) {
        scene.remove(craft.mesh);
        transientCrafts.splice(i, 1);
      }
    }
  }

  // ── SHOOTING STARS ─────────────────────────────────────────────────────
  const shootingStars = [];
  function spawnShootingStar() {
    const pts = [new THREE.Vector3(0,0,0), new THREE.Vector3(-30,-9,-6)];
    const line = new THREE.Line(
      new THREE.BufferGeometry().setFromPoints(pts),
      new THREE.LineBasicMaterial({color:0xeaf7ff, transparent:true, opacity:0.78})
    );
    line.position.set(
      camera.position.x+(Math.random()-.5)*900,
      camera.position.y+80+Math.random()*350,
      camera.position.z+(Math.random()-.5)*900
    );
    const a = Math.random()*Math.PI*2, sp = 7+Math.random()*8;
    scene.add(line);
    shootingStars.push({line, vx:Math.cos(a)*sp, vy:-(2+Math.random()*3), vz:Math.sin(a)*sp, life:50+Math.random()*35, max:85});
  }
  setInterval(spawnShootingStar, 3200);

  function updateShootingStars() {
    for (let i = shootingStars.length-1; i >= 0; i--) {
      const ss = shootingStars[i];
      ss.line.position.x += ss.vx; ss.line.position.y += ss.vy; ss.line.position.z += ss.vz;
      ss.life--;
      ss.line.material.opacity = Math.max(0, (ss.life/ss.max)*0.78);
      if (ss.life <= 0) { scene.remove(ss.line); shootingStars.splice(i,1); }
    }
  }

  // ── COUNTDOWN ──────────────────────────────────────────────────────────
  function updateCD() {
    const d = Math.max(0, Math.floor((new Date('2026-06-09').getTime()-Date.now())/86400000));
    document.getElementById('hcd').textContent = String(d).padStart(2,'0') + ' D';
  }
  updateCD(); setInterval(updateCD, 60000);

  // ── RENDER LOOP ─────────────────────────────────────────────────────────
  const clock = new THREE.Clock();
  let elapsed = 0;

  function animate() {
    requestAnimationFrame(animate);
    const dt = Math.min(clock.getDelta(), 0.05);
    elapsed += dt;
    if (gameActive) {
      if (tourActive) updateAutoTour(dt);
      else updateMovement(dt);
      checkLookAt();
    }
    updateTransientCrafts(dt);
    updateShootingStars();
    updateBlackHoleEvent();

    projects.forEach(p => {
      if (!p.group) return;
      p.group.rotation.y += p.spin ?? 0.001;
      if (p.surface) p.surface.rotation.y += 0.00045;
      p.group.children.forEach(ch => {
        if (ch.userData?.isClouds) ch.rotation.y += ch.userData.speed;
        if (ch.userData?.isRing) ch.rotation.z += ch.userData.speed;
        if (ch.userData?.isMoonPivot) ch.rotation.y += ch.userData.speed;
      });
    });

    cosmicAccents.forEach((obj, i) => {
      obj.rotation.y += obj.userData?.drift ?? 0.00001;
      if (obj.material && obj.userData?.baseOpacity !== undefined) {
        obj.material.opacity = obj.userData.baseOpacity * (0.92 + Math.sin(elapsed * 0.08 + obj.userData.phase + i) * 0.08);
      }
    });

    sunMesh.rotation.y += 0.00032;
    if (sunMesh.material?.uniforms?.uTime) sunMesh.material.uniforms.uTime.value = elapsed;
    sunLight.intensity = 74000 + Math.sin(elapsed*0.22)*2600;
    solarCorona.material.opacity = 0.17 + Math.sin(elapsed*0.18)*0.012;
    solarOuterGlow.material.opacity = 0.072 + Math.sin(elapsed*0.12 + 0.6)*0.008;
    solarFarGlow.material.opacity = 0.024 + Math.sin(elapsed*0.09 + 1.3)*0.004;
    solarFlare.material.opacity = 0.21 + Math.sin(elapsed*0.17)*0.02;
    composer.render();
  }

  document.getElementById('audio-btn')?.addEventListener('click', () => {
    setAudioEnabled(!audioEnabled);
  });

  document.getElementById('tour-btn')?.addEventListener('click', () => {
    if (!gameActive) return;
    setTourActive(!tourActive);
  });

  document.getElementById('startBtn').addEventListener('click', () => {
    const ctrl = document.getElementById('ctrl');
    setAudioEnabled(audioEnabled);
    ctrl.style.opacity = '0';
    setTimeout(() => { ctrl.style.display='none'; gameActive=true; blackHoleGameActive=true; renderer.domElement.requestPointerLock(); setTimeout(spawnCinematicFlyby, 6500); }, 500);
  });

  animate();
}

// Countdown during loading
(function tickCD() {
  const d = Math.max(0, Math.floor((new Date('2026-06-09').getTime()-Date.now())/86400000));
  const el = document.getElementById('hcd');
  if (el) el.textContent = String(d).padStart(2,'0') + ' D';
})();
</script>
</body>
</html>
