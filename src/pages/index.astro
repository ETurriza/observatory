  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Space+Grotesk:wght@400;500;600&display=swap" rel="stylesheet" />
  <style>
    :root{
      --bg:#05070d;--panel:#070c15;--cyan:#37c9ff;--line:rgba(93,177,222,.18);
      --text:#eaf7ff;--muted:rgba(219,239,255,.48);--dim:rgba(219,239,255,.28);
      --ok:#57f59a;--warn:#ffc66d;
    }
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    html,body{width:100%;min-height:100%;background:#111;color:var(--text);font-family:'JetBrains Mono',monospace}
    body{display:flex;align-items:center;justify-content:center;padding:18px;overflow:hidden}
    .shell{position:relative;width:min(1180px,calc(100vw - 36px));height:min(900px,calc(100vh - 36px));min-height:680px;border-radius:16px;overflow:hidden;background:radial-gradient(circle at 26% 26%,rgba(55,201,255,.065),transparent 36%),radial-gradient(circle at 78% 62%,rgba(142,100,255,.055),transparent 34%),linear-gradient(180deg,#050914,#02040a);border:1px solid rgba(116,196,238,.16);box-shadow:0 28px 90px rgba(0,0,0,.55), inset 0 1px rgba(255,255,255,.04)}
    .noise{position:absolute;inset:0;pointer-events:none;opacity:.21;background-image:radial-gradient(circle,rgba(255,255,255,.6) 0 1px,transparent 1.4px),radial-gradient(circle,rgba(64,190,255,.36) 0 1px,transparent 1.5px);background-size:118px 118px,183px 183px;background-position:0 0,34px 67px;mask-image:linear-gradient(180deg,rgba(0,0,0,.95),rgba(0,0,0,.25))}
    .hud-line{position:absolute;background:var(--line);pointer-events:none}.hud-v{width:1px;top:78px;bottom:44px;right:360px}.hud-h{height:1px;left:0;right:0;top:78px}.hud-b{height:1px;left:44px;right:360px;bottom:44px}
    .corner{position:absolute;width:28px;height:28px;border-color:rgba(93,177,222,.28);border-style:solid}.c1{top:16px;left:16px;border-width:1px 0 0 1px}.c2{top:16px;right:16px;border-width:1px 1px 0 0}.c3{bottom:16px;left:16px;border-width:0 0 1px 1px}.c4{bottom:16px;right:16px;border-width:0 1px 1px 0}
    .top-nav{display:flex;align-items:center;justify-content:center;gap:16px;min-width:0;z-index:3;transform:translateX(-52px)}.top-nav a{font-size:10px;color:rgba(219,239,255,.36);text-decoration:none;letter-spacing:.1em;text-transform:lowercase;transition:color .18s,text-shadow .18s;white-space:nowrap}.top-nav a:hover{color:rgba(223,244,255,.9);text-shadow:0 0 12px rgba(74,212,255,.22)}.top-nav .space-link{color:rgba(255,218,176,.62)}.top-nav .space-link:hover{color:#fff;text-shadow:0 0 14px rgba(255,198,109,.22)}header{position:absolute;top:0;left:0;right:0;height:78px;display:grid;grid-template-columns:minmax(260px,1fr) minmax(260px,310px) 96px 148px 110px 166px;align-items:center;padding:0 28px;border-bottom:1px solid var(--line);background:rgba(3,7,14,.52);backdrop-filter:blur(12px)}
    .brand{font-family:'JetBrains Mono',monospace;color:#4ad4ff;letter-spacing:.16em;font-size:15px;white-space:nowrap;min-width:0}.brand span{color:#eaf7ff}
    .stat{height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;border-left:1px solid rgba(93,177,222,.13)}.stat-num{font-family:'Space Grotesk',sans-serif;font-size:19px;color:#41cfff;line-height:1}.stat-label{font-size:9px;color:var(--dim);letter-spacing:.13em;margin-top:6px;text-transform:uppercase}
    .system{display:flex;align-items:center;justify-content:flex-end;gap:9px;height:100%;border-left:1px solid rgba(93,177,222,.13);color:var(--ok);font-size:11px;letter-spacing:.12em;text-transform:uppercase}.dot{width:8px;height:8px;border-radius:50%;background:var(--ok);box-shadow:0 0 16px rgba(87,245,154,.45)}
    main{position:absolute;left:0;right:360px;top:78px;bottom:44px;padding:28px 26px}.section-title{color:rgba(74,212,255,.62);letter-spacing:.18em;font-size:11px;text-transform:uppercase;margin-bottom:18px}
    .map{position:absolute;left:26px;right:26px;top:68px;bottom:22px;border-radius:12px;overflow:hidden}.radar-grid{position:absolute;inset:0;opacity:.22;background:linear-gradient(rgba(93,177,222,.08) 1px,transparent 1px),linear-gradient(90deg,rgba(93,177,222,.08) 1px,transparent 1px);background-size:72px 72px;mask-image:radial-gradient(circle at 50% 50%,black 0%,transparent 72%)}
    .orbit{position:absolute;border:1px solid rgba(93,177,222,.09);border-radius:50%;transform:translate(-50%,-50%) rotate(-16deg);pointer-events:none}.orbit.o1{left:50%;top:52%;width:330px;height:180px}.orbit.o2{left:50%;top:52%;width:560px;height:300px}.orbit.o3{left:50%;top:52%;width:780px;height:420px}
    .crosshair{display:none!important}
    .planet-node{position:absolute;width:78px;height:78px;transform:translate(-50%,-50%);display:flex;align-items:center;justify-content:center;cursor:pointer;border:none;background:transparent;color:var(--text);font-family:'JetBrains Mono',monospace;z-index:3}.planet-node:focus-visible{outline:1px solid var(--cyan);border-radius:50%}
    .planet-core{width:28px;height:28px;border-radius:50%;background:var(--p);box-shadow:0 0 0 14px color-mix(in srgb,var(--p) 17%,transparent),0 0 22px color-mix(in srgb,var(--p) 38%,transparent);transition:transform .18s,box-shadow .18s}.planet-node:hover .planet-core,.planet-node.active .planet-core{transform:scale(1.16);box-shadow:0 0 0 20px color-mix(in srgb,var(--p) 20%,transparent),0 0 30px color-mix(in srgb,var(--p) 62%,transparent)}
    .planet-label{position:absolute;top:62px;left:50%;transform:translateX(-50%);min-width:150px;text-align:center;text-shadow:0 0 10px rgba(255,255,255,.16);pointer-events:none}.planet-label strong{display:block;font-family:'Space Grotesk',sans-serif;font-size:12px;color:rgba(235,246,255,.68);line-height:1.1}.planet-label span{display:block;font-size:8px;color:rgba(151,203,232,.45);letter-spacing:.12em;margin-top:3px}
    .unlock{position:absolute;left:50%;bottom:24px;transform:translateX(-50%) translateY(12px);display:flex;align-items:center;gap:12px;border:1px solid rgba(255,198,109,.24);background:rgba(255,198,109,.055);border-radius:12px;padding:12px 16px;opacity:0;pointer-events:none;transition:opacity .3s,transform .3s;box-shadow:0 0 30px rgba(255,198,109,.055)}.unlock.on{opacity:1;pointer-events:auto;transform:translateX(-50%) translateY(0)}.unlock-text{font-size:9px;letter-spacing:.14em;color:rgba(255,218,176,.78);text-transform:uppercase}.unlock a{color:#fff;text-decoration:none;font-size:9px;letter-spacing:.12em;border:1px solid rgba(255,218,176,.32);border-radius:8px;padding:8px 11px;background:rgba(255,218,176,.06)}
    aside{position:absolute;right:0;top:78px;bottom:44px;width:360px;padding:24px 26px 34px;background:rgba(3,7,14,.42);border-left:1px solid var(--line);overflow-y:auto;overscroll-behavior:contain}.side-card{border-bottom:1px solid rgba(93,177,222,.13);padding-bottom:24px;margin-bottom:24px}.side-title{font-size:11px;color:rgba(74,212,255,.62);letter-spacing:.16em;text-transform:uppercase;margin-bottom:16px}
    .count-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.count-box{height:78px;border:1px solid rgba(93,177,222,.18);border-radius:9px;display:flex;flex-direction:column;align-items:center;justify-content:center;background:rgba(55,201,255,.035)}.count-box strong{font-family:'Space Grotesk',sans-serif;font-size:28px;color:#42d3ff;line-height:1}.count-box span{font-size:9px;color:var(--dim);letter-spacing:.12em;margin-top:8px;text-transform:uppercase}.dest{font-size:10px;color:var(--dim);margin-top:13px;letter-spacing:.05em}.dest span{color:#4ad4ff}
    .radar{width:190px;height:190px;margin:8px auto 0;position:relative;border-radius:50%;border:1px solid rgba(93,177,222,.1);background:radial-gradient(circle,rgba(55,201,255,.04),transparent 62%)}.radar::before,.radar::after{content:"";position:absolute;inset:31px;border:1px solid rgba(93,177,222,.08);border-radius:50%}.radar::after{inset:62px}.sweep{position:absolute;left:50%;top:50%;width:1px;height:80px;background:linear-gradient(180deg,rgba(55,201,255,.65),rgba(55,201,255,0));transform-origin:bottom center;animation:sweep 8s linear infinite}@keyframes sweep{from{transform:translate(-50%,-100%) rotate(0)}to{transform:translate(-50%,-100%) rotate(360deg)}}.r-dot{position:absolute;width:9px;height:9px;border-radius:50%;background:var(--p);box-shadow:0 0 14px color-mix(in srgb,var(--p) 52%,transparent)}
    aside::-webkit-scrollbar{width:5px}aside::-webkit-scrollbar-thumb{background:rgba(93,177,222,.24);border-radius:999px}aside::-webkit-scrollbar-track{background:transparent}.language-list{display:grid;grid-template-columns:1fr 1fr;gap:9px}.language{border:1px solid rgba(93,177,222,.14);background:rgba(255,255,255,.025);color:rgba(230,242,255,.68);border-radius:8px;padding:8px 10px;font-size:10px;letter-spacing:.08em;text-transform:uppercase}
    footer{position:absolute;left:0;right:0;bottom:0;height:44px;display:flex;align-items:center;gap:26px;padding:0 30px;border-top:1px solid var(--line);font-size:10px;color:var(--dim);letter-spacing:.08em;text-transform:uppercase;background:rgba(3,7,14,.5)}footer span{color:#4ad4ff}
    .modal-backdrop{position:absolute;inset:0;z-index:50;display:none;align-items:center;justify-content:center;background:radial-gradient(circle at 50% 50%,rgba(6,12,22,.38),rgba(0,0,0,.68));backdrop-filter:blur(4px)}.modal-backdrop.on{display:flex}.modal{position:relative;width:min(620px,calc(100vw - 44px));background:linear-gradient(180deg,rgba(7,12,22,.97),rgba(1,4,10,.985));border:1px solid rgba(169,217,244,.28);border-radius:16px;box-shadow:0 28px 90px rgba(0,0,0,.66),0 0 42px rgba(151,203,232,.08),inset 0 1px rgba(255,255,255,.055);padding:26px 28px 24px}.close{position:absolute;top:14px;right:16px;width:30px;height:30px;border:1px solid rgba(169,217,244,.24);border-radius:8px;background:rgba(169,217,244,.04);color:rgba(223,244,255,.7);font-size:16px;font-family:'JetBrains Mono',monospace;cursor:pointer}.modal-id{font-size:8px;color:rgba(151,203,232,.5);letter-spacing:.18em;text-transform:uppercase;margin-bottom:7px}.modal-title{font-family:'Space Grotesk',sans-serif;font-size:28px;line-height:1.05;font-weight:500;color:#fff;padding-right:34px}.modal-type{display:inline-block;margin-top:10px;margin-bottom:16px;font-size:8px;letter-spacing:.14em;text-transform:uppercase;padding:4px 9px;border-radius:6px;border:1px solid currentColor;background:rgba(255,255,255,.025)}.modal-summary{font-size:12px;color:rgba(230,242,255,.72);line-height:1.85;letter-spacing:.025em}.modal-tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:18px}.modal-tag{font-size:8px;padding:3px 7px;border-radius:5px;background:rgba(255,255,255,.045);border:1px solid rgba(255,255,255,.085);color:rgba(223,244,255,.45)}.modal-footer{display:flex;justify-content:flex-end;margin-top:20px}.modal-link{display:none;font-size:9px;padding:8px 13px;border-radius:6px;border:1px solid currentColor;background:rgba(169,217,244,.035);color:var(--cyan);text-decoration:none;letter-spacing:.08em}
    @media (max-width:1080px){header{grid-template-columns:minmax(220px,1fr) minmax(200px,250px) 82px 120px 92px 148px;padding:0 18px}.top-nav{gap:10px;transform:translateX(-36px)}.top-nav a{font-size:9px}}@media (max-width:920px){.top-nav{display:none}body{padding:0;overflow:auto}.shell{width:100vw;height:auto;min-height:100vh;border-radius:0}header{position:relative;grid-template-columns:1fr 70px 84px 70px;gap:0;padding:0 18px}.system{display:none}main{position:relative;left:auto;right:auto;top:auto;bottom:auto;height:590px}aside{position:relative;right:auto;top:auto;bottom:auto;width:auto;border-left:0;border-top:1px solid var(--line)}.hud-v,.hud-b{display:none}footer{position:relative;height:auto;min-height:44px;flex-wrap:wrap;padding:12px 18px}}
  </style>
</head>
<body>
  <div class="shell">
    <div class="noise"></div><div class="hud-line hud-h"></div><div class="hud-line hud-v"></div><div class="hud-line hud-b"></div><div class="corner c1"></div><div class="corner c2"></div><div class="corner c3"></div><div class="corner c4"></div>
    <header><div class="brand">ET — OBS/1 · <span>CONTROL</span></div><nav class="top-nav" aria-label="Navegación principal"><a href="./objects/">objects</a><a href="./log/">log</a><a href="./about/">about</a><a class="space-link" href="./space/">obs/3d</a></nav><div class="stat"><div class="stat-num">7</div><div class="stat-label">Objetos</div></div><div class="stat"><div class="stat-num" id="daysTop">--d</div><div class="stat-label">Braingeneers</div></div><div class="stat"><div class="stat-num">2</div><div class="stat-label">Idiomas</div></div><div class="system"><span class="dot"></span>Sistema activo</div></header>
    <main><div class="section-title">// Mapa estelar interactivo — selecciona un objeto para inspeccionar</div><div class="map" id="map"><div class="radar-grid"></div><div class="orbit o1"></div><div class="orbit o2"></div><div class="orbit o3"></div>
      <button class="planet-node" data-id="lidera" style="left:34%;top:25%;--p:#d9aa2f"><span class="planet-core"></span><span class="planet-label"><strong>1er lugar LIDERA</strong><span>NGC-005</span></span></button>
      <button class="planet-node" data-id="upf" style="left:58%;top:42%;--p:#d7833c"><span class="planet-core"></span><span class="planet-label"><strong>UPF Barcelona</strong><span>NGC-006</span></span></button>
      <button class="planet-node" data-id="dbscan" style="left:27%;top:55%;--p:#c45a95"><span class="planet-core"></span><span class="planet-label"><strong>DBSCAN paralelo</strong><span>NGC-004</span></span></button>
      <button class="planet-node" data-id="bases" style="left:21%;top:73%;--p:#6aa7ff"><span class="planet-core"></span><span class="planet-label"><strong>Bases de Datos</strong><span>NGC-007</span></span></button>
      <button class="planet-node" data-id="braingeneers" style="left:39%;top:70%;--p:#9c72dc"><span class="planet-core"></span><span class="planet-label"><strong>Braingeneers</strong><span>NGC-003</span></span></button>
      <button class="planet-node" data-id="robot" style="left:52%;top:82%;--p:#55c6a4"><span class="planet-core"></span><span class="planet-label"><strong>Robot bombero</strong><span>NGC-002</span></span></button>
      <button class="planet-node" data-id="gaiatools" style="left:74%;top:62%;--p:#4fc3ec"><span class="planet-core"></span><span class="planet-label"><strong>gaiatools</strong><span>NGC-001</span></span></button>
      <div class="unlock" id="unlock"><div class="unlock-text">Coordenadas ocultas detectadas</div><a href="./space/">Entrar al OBS/3D</a></div>
    </div></main>
    <aside>
      <section class="side-card"><div class="side-title">// Cuenta regresiva — Braingeneers</div><div class="count-grid"><div class="count-box"><strong id="days">--</strong><span>Días</span></div><div class="count-box"><strong id="hours">--</strong><span>Horas</span></div><div class="count-box"><strong id="mins">--</strong><span>Mins</span></div><div class="count-box"><strong id="secs">--</strong><span>Segs</span></div></div><div class="dest">Destino: <span>UC Santa Cruz</span></div></section>
      <section class="side-card"><div class="side-title">// Radar — objetos activos</div><div class="radar"><div class="sweep"></div><span class="r-dot" style="--p:#d9aa2f;left:48px;top:24px"></span><span class="r-dot" style="--p:#d7833c;left:132px;top:20px"></span><span class="r-dot" style="--p:#c45a95;left:24px;top:96px"></span><span class="r-dot" style="--p:#6aa7ff;left:36px;top:128px"></span><span class="r-dot" style="--p:#9c72dc;left:56px;top:154px"></span><span class="r-dot" style="--p:#55c6a4;left:122px;top:148px"></span><span class="r-dot" style="--p:#4fc3ec;left:148px;top:96px"></span></div></section>
      <section style="padding-bottom:18px"><div class="side-title">// Lenguajes y herramientas</div><div class="language-list"><div class="language">Python</div><div class="language">C/C++</div><div class="language">PyTorch</div><div class="language">AVR ASM</div><div class="language">OpenMP</div><div class="language">MPI</div><div class="language">Astro</div><div class="language">Three.js</div><div class="language">SQL</div><div class="language">DB Design</div></div></section>
    </aside>
    <footer><div>Origen: <span>ITAM · CDMX</span></div><div>Destino: <span>UC Santa Cruz</span></div><div>Graduación: <span>Marzo 2027</span></div></footer>
    <div class="modal-backdrop" id="modalBackdrop"><section class="modal"><button class="close" id="closeModal">×</button><div class="modal-id" id="modalId"></div><div class="modal-title" id="modalTitle"></div><div class="modal-type" id="modalType"></div><div class="modal-summary" id="modalSummary"></div><div class="modal-tags" id="modalTags"></div><div class="modal-footer"><a class="modal-link" id="modalLink" target="_blank" rel="noopener noreferrer"></a></div></section></div>
  </div>
  <script>
    const projects={gaiatools:{id:'NGC-001',title:'gaiatools',type:'planeta oceánico',color:'#4fc3ec',summary:'Librería de Python publicada en PyPI para consultar y analizar el catálogo estelar ESA Gaia DR3. Incluye clustering con HDBSCAN, diagramas Hertzsprung-Russell interactivos con Plotly, crossmatching con el NASA Exoplanet Archive, soporte Docker y CI/CD con GitHub Actions.',tags:['Python','PyPI','HDBSCAN','Plotly'],url:'https://github.com/ETurriza/gaiatools',label:'VER EN GITHUB'},robot:{id:'NGC-002',title:'Robot bombero',type:'cuerpo rocoso',color:'#55c6a4',summary:'Robot autónomo programado en AVR assembly puro para el microcontrolador ATmega2560. Implementa una máquina de 4 estados: seguimiento de línea con sensores TCRT5000, detección de llama con fotoresistores, identificación de base por color con sensor TCS230, y extinción con bomba de agua controlada por servo.',tags:['AVR Assembly','ATmega2560','Sensores','Robótica'],url:'https://github.com/ETurriza/firefighter-robot',label:'VER EN GITHUB'},braingeneers:{id:'NGC-003',title:'Braingeneers',type:'gigante gaseoso',color:'#9c72dc',summary:'Investigación en el Braingeneers Lab de UC Santa Cruz (verano 2026). Aplica deep learning para caracterizar redes neuronales emergentes usando datos de electrofisiología. Trabajo bajo Hunter Schweiger con sponsorship de Mohammed Mostajo-Radji y Mircea Teodorescu. Parte del programa ISRP.',tags:['Deep Learning','Electrofisiología','UC Santa Cruz'],url:'https://braingeneers.ucsc.edu/',label:'VER SITIO WEB'},dbscan:{id:'NGC-004',title:'DBSCAN paralelo',type:'objeto computacional',color:'#c45a95',summary:'Implementación del algoritmo DBSCAN desde cero en C++, paralelizado con OpenMP. Logra un speedup de 2.0x sobre la versión serial procesando más de 900,000 registros del dataset de crímenes del LAPD. Incluye análisis de escalabilidad y versión distribuida con MPI.',tags:['C++','OpenMP','MPI','HPC']},bases:{id:'NGC-007',title:'Bases de Datos',type:'archivo relacional',color:'#6aa7ff',summary:'Proyecto final de Bases de Datos en el ITAM, desarrollado en Otoño 2024. Se diseñó un sistema de gestión de datos para almacenar, administrar y analizar información del dataset de crímenes de Los Ángeles. Incluye limpieza de datos, normalización, creación de tablas e inserción mediante SQL, además de consultas estadísticas sobre horarios, zonas y tipos de crimen.',tags:['SQL','Normalización','Data Cleaning','LA Crime Data'],url:'https://github.com/Diego-FRM/Proyecto-Bases-de-Datos',label:'VER EN GITHUB'},lidera:{id:'NGC-005',title:'1er lugar LIDERA',type:'registro dorado',color:'#d9aa2f',summary:'Líder del equipo de robótica del Anáhuac en el premio LIDERA 2022. Primer lugar en la competencia nacional. Coordinó el diseño mecánico, electrónico y de software del robot, llevando al equipo desde la fase regional hasta la victoria en la final nacional.',tags:['Robótica','Liderazgo','Competencia nacional']},upf:{id:'NGC-006',title:'UPF Barcelona',type:'archivo internacional',color:'#d7833c',summary:'Semestre de intercambio en la Universitat Pompeu Fabra, Barcelona, primavera 2024. Coursework en Machine Learning, Deep Learning y Computer Graphics. Primera experiencia académica internacional, combinando ingeniería con perspectiva europea en tecnología.',tags:['Machine Learning','Deep Learning','Computer Graphics']}};
    const sequence=['gaiatools','braingeneers','robot'];let progress=0;const modal=document.getElementById('modalBackdrop'),modalId=document.getElementById('modalId'),modalTitle=document.getElementById('modalTitle'),modalType=document.getElementById('modalType'),modalSummary=document.getElementById('modalSummary'),modalTags=document.getElementById('modalTags'),modalLink=document.getElementById('modalLink'),unlock=document.getElementById('unlock');

    function moveCrosshair(event){
      if(!mapEl || !crosshair) return;
      const rect=mapEl.getBoundingClientRect();
      const size=50;
      const x=Math.max(size/2,Math.min(rect.width-size/2,event.clientX-rect.left));
      const y=Math.max(size/2,Math.min(rect.height-size/2,event.clientY-rect.top));
      crosshair.style.left=`${x-size/2}px`;
      crosshair.style.top=`${y-size/2}px`;
      crosshair.style.opacity='1';
    }

    mapEl?.addEventListener('mousemove',moveCrosshair);
    mapEl?.addEventListener('mouseenter',event=>{moveCrosshair(event); if(crosshair) crosshair.style.opacity='1';});
    mapEl?.addEventListener('mouseleave',()=>{if(crosshair) crosshair.style.opacity='.52';});
    function openProject(key){const p=projects[key];if(!p)return;document.querySelectorAll('.planet-node').forEach(n=>n.classList.toggle('active',n.dataset.id===key));modalId.textContent=`${p.id} · ${p.type}`;modalTitle.textContent=p.title;modalType.textContent=p.type;modalType.style.color=p.color;modalType.style.borderColor=p.color;modalSummary.textContent=p.summary;modalTags.innerHTML=p.tags.map(t=>`<span class="modal-tag">${t}</span>`).join('');if(p.url){modalLink.style.display='inline-block';modalLink.href=p.url;modalLink.textContent=p.label||'VER ENLACE';modalLink.style.color=p.color}else{modalLink.style.display='none'}modal.classList.add('on');if(key===sequence[progress]){progress++;if(progress===sequence.length)unlock.classList.add('on')}else{progress=key===sequence[0]?1:0}}
    document.querySelectorAll('.planet-node').forEach(node=>node.addEventListener('click',()=>openProject(node.dataset.id)));document.getElementById('closeModal').addEventListener('click',()=>modal.classList.remove('on'));modal.addEventListener('click',event=>{if(event.target===modal)modal.classList.remove('on')});window.addEventListener('keydown',event=>{if(event.key==='Escape')modal.classList.remove('on')});
    function updateCountdown(){const target=new Date('2026-06-15T00:00:00'),now=new Date(),diff=Math.max(0,target-now),days=Math.floor(diff/86400000),hours=Math.floor((diff%86400000)/3600000),mins=Math.floor((diff%3600000)/60000),secs=Math.floor((diff%60000)/1000);document.getElementById('days').textContent=String(days).padStart(2,'0');document.getElementById('hours').textContent=String(hours).padStart(2,'0');document.getElementById('mins').textContent=String(mins).padStart(2,'0');document.getElementById('secs').textContent=String(secs).padStart(2,'0');document.getElementById('daysTop').textContent=`${days}d`}
    updateCountdown();setInterval(updateCountdown,1000);
  </script>
</body>
</html>
