function addStarLayer(radius, count, size, opacity, color = 0xffffff) {
  const arr = new Float32Array(count * 3);
  for (let i = 0; i < count; i++) {
    const th = Math.random() * Math.PI * 2;
    const u = Math.random() * 2 - 1;
    const ph = Math.acos(u);
    const r = radius * (0.94 + Math.random() * 0.06);
    arr[i*3]   = r * Math.sin(ph) * Math.cos(th);
    arr[i*3+1] = r * Math.cos(ph);
    arr[i*3+2] = r * Math.sin(ph) * Math.sin(th);
  }
  const g = new THREE.BufferGeometry();
  g.setAttribute('position', new THREE.BufferAttribute(arr, 3));
  const stars = new THREE.Points(g, new THREE.PointsMaterial({
    map: starSprite,
    color,
    size,
    transparent: true,
    opacity,
    alphaTest: 0.01,
    sizeAttenuation: true,
    depthWrite: false,
    fog: false,
    blending: THREE.AdditiveBlending,
  }));
  scene.add(stars);
  return stars;
}

function addInterstellarDust(cx, cy, cz, color, radius, count, opacity, size) {
  const arr = new Float32Array(count * 3);
  for (let i = 0; i < count; i++) {
    const th = Math.random() * Math.PI * 2;
    const ph = Math.acos(2 * Math.random() - 1);
    const r = Math.pow(Math.random(), 0.32) * radius;
    arr[i*3]   = cx + r * Math.sin(ph) * Math.cos(th);
    arr[i*3+1] = cy + r * Math.cos(ph) * 0.34;
    arr[i*3+2] = cz + r * Math.sin(ph) * Math.sin(th);
  }
  const g = new THREE.BufferGeometry();
  g.setAttribute('position', new THREE.BufferAttribute(arr, 3));
  const dust = new THREE.Points(g, new THREE.PointsMaterial({
    map: dustSprite,
    alphaTest: 0.01,
    color,
    size,
    transparent: true,
    opacity,
    sizeAttenuation: true,
    fog: false,
    blending: THREE.AdditiveBlending,
    depthWrite: false,
  }));
  scene.add(dust);
  return dust;
}

function makeNebulaTexture(size = 512, stops = [
  [0.0, 'rgba(255,255,255,.32)'],
  [0.42,'rgba(160,190,220,.16)'],
  [1.0, 'rgba(0,0,0,0)']
]) {
  const c = document.createElement('canvas');
  c.width = c.height = size;
  const ctx = c.getContext('2d');

  // Large asymmetric gas mass
  const cx = size * (0.46 + (Math.random() - 0.5) * 0.05);
  const cy = size * (0.50 + (Math.random() - 0.5) * 0.05);
  const g = ctx.createRadialGradient(cx, cy, size * 0.03, cx, cy, size * 0.56);
  stops.forEach(([stop, color]) => g.addColorStop(stop, color));
  ctx.fillStyle = g;
  ctx.fillRect(0, 0, size, size);

  // Soft filamentary streaks. Very low contrast to avoid the arcade look.
  ctx.globalCompositeOperation = 'lighter';
  for (let i = 0; i < 42; i++) {
    const x = size * (0.18 + Math.random() * 0.64);
    const y = size * (0.18 + Math.random() * 0.64);
    const rx = size * (0.05 + Math.random() * 0.18);
    const ry = size * (0.012 + Math.random() * 0.045);
    ctx.save();
    ctx.translate(x, y);
    ctx.rotate((Math.random() - 0.5) * Math.PI);
    const alpha = 0.012 + Math.random() * 0.026;
    const local = ctx.createRadialGradient(0, 0, 0, 0, 0, Math.max(rx, ry));
    local.addColorStop(0, `rgba(255,255,255,${alpha})`);
    local.addColorStop(1, 'rgba(255,255,255,0)');
    ctx.fillStyle = local;
    ctx.scale(rx / Math.max(rx, ry), ry / Math.max(rx, ry));
    ctx.beginPath();
    ctx.arc(0, 0, Math.max(rx, ry), 0, Math.PI * 2);
    ctx.fill();
    ctx.restore();
  }

  // Sparse dark pockets give the cloud a less uniform, more astrophotographic feel.
  ctx.globalCompositeOperation = 'destination-out';
  for (let i = 0; i < 18; i++) {
    const x = size * (0.16 + Math.random() * 0.68);
    const y = size * (0.16 + Math.random() * 0.68);
    const r = size * (0.035 + Math.random() * 0.095);
    const dark = ctx.createRadialGradient(x, y, 0, x, y, r);
    dark.addColorStop(0, 'rgba(0,0,0,.11)');
    dark.addColorStop(1, 'rgba(0,0,0,0)');
    ctx.fillStyle = dark;
    ctx.beginPath();
    ctx.arc(x, y, r, 0, Math.PI * 2);
    ctx.fill();
  }

  const tex = new THREE.CanvasTexture(c);
  if ('colorSpace' in tex && THREE.SRGBColorSpace) tex.colorSpace = THREE.SRGBColorSpace;
  tex.minFilter = THREE.LinearMipmapLinearFilter;
  tex.magFilter = THREE.LinearFilter;
  tex.generateMipmaps = true;
  return tex;
}

function addSoftNebulaBillboard({
  position,
  scale,
  color = 0x9fb4c8,
  opacity = 0.08,
  rotation = 0,
  drift = 0.00002,
  stops,
}) {
  const sprite = new THREE.Sprite(new THREE.SpriteMaterial({
    map: makeNebulaTexture(512, stops),
    color,
    transparent: true,
    opacity,
    blending: THREE.AdditiveBlending,
    depthWrite: false,
    depthTest: true,
    fog: false,
  }));
  sprite.position.copy(position);
  sprite.scale.set(scale.x, scale.y, 1);
  sprite.material.rotation = rotation;
  sprite.userData = {
    isCosmicAccent: true,
    baseOpacity: opacity,
    drift,
    phase: Math.random() * Math.PI * 2,
  };
  scene.add(sprite);
  cosmicAccents.push(sprite);
  return sprite;
}

function addSupernovaRemnant({
  position,
  radius = 120,
  color = 0xaab8c5,
  count = 1400,
  opacity = 0.055,
}) {
  const arr = new Float32Array(count * 3);
  const colors = new Float32Array(count * 3);
  const base = new THREE.Color(color);

  for (let i = 0; i < count; i++) {
    const th = Math.random() * Math.PI * 2;
    const ph = Math.acos(2 * Math.random() - 1);
    const shell = radius * (0.78 + Math.random() * 0.32);
    const distortion = 1 + Math.sin(th * 3.0 + ph * 2.0) * 0.08;
    arr[i*3]   = position.x + shell * distortion * Math.sin(ph) * Math.cos(th);
    arr[i*3+1] = position.y + shell * 0.62 * Math.cos(ph);
    arr[i*3+2] = position.z + shell * distortion * Math.sin(ph) * Math.sin(th);

    const tint = base.clone().offsetHSL((Math.random() - 0.5) * 0.035, 0, (Math.random() - 0.5) * 0.16);
    colors[i*3] = tint.r;
    colors[i*3+1] = tint.g;
    colors[i*3+2] = tint.b;
  }

  const g = new THREE.BufferGeometry();
  g.setAttribute('position', new THREE.BufferAttribute(arr, 3));
  g.setAttribute('color', new THREE.BufferAttribute(colors, 3));

  const remnant = new THREE.Points(g, new THREE.PointsMaterial({
    map: dustSprite,
    size: 5.6,
    vertexColors: true,
    transparent: true,
    opacity,
    alphaTest: 0.01,
    blending: THREE.AdditiveBlending,
    depthWrite: false,
    fog: false,
    sizeAttenuation: true,
  }));

  remnant.userData = {
    isCosmicAccent: true,
    baseOpacity: opacity,
    drift: 0.000012,
    phase: Math.random() * Math.PI * 2,
  };
  scene.add(remnant);
  cosmicAccents.push(remnant);
  return remnant;
}


function makeBlackHoleDiskTexture(size = 768) {
  const c = document.createElement('canvas');
  c.width = c.height = size;
  const ctx = c.getContext('2d');
  const cx = size / 2;
  const cy = size / 2;

  ctx.clearRect(0, 0, size, size);
  ctx.translate(cx, cy);
  ctx.scale(1, 0.48);

  // Warm accretion body
  const g = ctx.createRadialGradient(0, 0, size * 0.08, 0, 0, size * 0.36);
  g.addColorStop(0.00, 'rgba(255,245,230,0)');
  g.addColorStop(0.22, 'rgba(255,248,236,.70)');
  g.addColorStop(0.38, 'rgba(255,196,122,.48)');
  g.addColorStop(0.55, 'rgba(255,126,62,.22)');
  g.addColorStop(0.78, 'rgba(90,34,18,.07)');
  g.addColorStop(1.00, 'rgba(0,0,0,0)');
  ctx.fillStyle = g;
  ctx.beginPath();
  ctx.arc(0, 0, size * 0.36, 0, Math.PI * 2);
  ctx.fill();

  // Filamentary hot streaks
  ctx.globalCompositeOperation = 'lighter';
  for (let i = 0; i < 240; i++) {
    const a = Math.random() * Math.PI * 2;
    const r = size * (0.15 + Math.random() * 0.23);
    const x = Math.cos(a) * r;
    const y = Math.sin(a) * r;
    const w = 3 + Math.random() * 18;
    const h = 0.8 + Math.random() * 2.8;
    ctx.save();
    ctx.translate(x, y);
    ctx.rotate(a + Math.PI / 2 + (Math.random() - 0.5) * 0.5);
    const alpha = 0.04 + Math.random() * 0.08;
    ctx.fillStyle = `rgba(255,220,170,${alpha})`;
    ctx.beginPath();
    ctx.ellipse(0, 0, w, h, 0, 0, Math.PI * 2);
    ctx.fill();
    ctx.restore();
  }

  // Transparent hole in the center
  ctx.globalCompositeOperation = 'destination-out';
  ctx.beginPath();
  ctx.arc(0, 0, size * 0.115, 0, Math.PI * 2);
  ctx.fill();

  const tex = new THREE.CanvasTexture(c);
  if ('colorSpace' in tex && THREE.SRGBColorSpace) tex.colorSpace = THREE.SRGBColorSpace;
  tex.minFilter = THREE.LinearMipmapLinearFilter;
  tex.magFilter = THREE.LinearFilter;
  tex.generateMipmaps = true;
  return tex;
}

function makeBlackHoleLensingTexture(size = 768) {
  const c = document.createElement('canvas');
  c.width = c.height = size;
  const ctx = c.getContext('2d');
  const cx = size / 2;
  const cy = size / 2;

  ctx.clearRect(0, 0, size, size);

  // Outer warped halo
  const halo = ctx.createRadialGradient(cx, cy, size * 0.14, cx, cy, size * 0.42);
  halo.addColorStop(0.00, 'rgba(255,255,255,0)');
  halo.addColorStop(0.18, 'rgba(255,244,225,.14)');
  halo.addColorStop(0.34, 'rgba(226,210,194,.12)');
  halo.addColorStop(0.52, 'rgba(188,156,170,.08)');
  halo.addColorStop(0.70, 'rgba(130,112,128,.04)');
  halo.addColorStop(1.00, 'rgba(0,0,0,0)');
  ctx.fillStyle = halo;
  ctx.beginPath();
  ctx.arc(cx, cy, size * 0.42, 0, Math.PI * 2);
  ctx.fill();

  // Distorted streaks to fake gravitational lensing
  ctx.globalCompositeOperation = 'lighter';
  for (let i = 0; i < 340; i++) {
    const a = Math.random() * Math.PI * 2;
    const r = size * (0.20 + Math.random() * 0.17);
    const x = cx + Math.cos(a) * r;
    const y = cy + Math.sin(a) * r;
    const rot = a + Math.PI / 2 + (Math.random() - 0.5) * 0.28;
    const len = 12 + Math.random() * 36;
    const wid = 1.0 + Math.random() * 3.2;
    ctx.save();
    ctx.translate(x, y);
    ctx.rotate(rot);
    const alpha = 0.018 + Math.random() * 0.05;
    ctx.fillStyle = `rgba(255,242,228,${alpha})`;
    ctx.beginPath();
    ctx.ellipse(0, 0, len, wid, 0, 0, Math.PI * 2);
    ctx.fill();
    ctx.restore();
  }

  // Dark central lens zone
  ctx.globalCompositeOperation = 'destination-out';
  ctx.beginPath();
  ctx.arc(cx, cy, size * 0.14, 0, Math.PI * 2);
  ctx.fill();

  const tex = new THREE.CanvasTexture(c);
  if ('colorSpace' in tex && THREE.SRGBColorSpace) tex.colorSpace = THREE.SRGBColorSpace;
  tex.minFilter = THREE.LinearMipmapLinearFilter;
  tex.magFilter = THREE.LinearFilter;
  tex.generateMipmaps = true;
  return tex;
}


