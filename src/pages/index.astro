    new THREE.PlaneGeometry(170, 170),
    new THREE.MeshBasicMaterial({
      map: makeBlackHoleDiskTexture(),
      color: 0xffc999,
      transparent: true,
      opacity: 0.52,
      blending: THREE.AdditiveBlending,
      depthWrite: false,
      side: THREE.DoubleSide,
      fog: false,
    })
  );
  diskBack.rotation.x = Math.PI / 2.58;
  diskBack.rotation.z = 0.34;
  diskBack.scale.set(1.0, 0.58, 1.0);
  diskBack.userData = { isAccretionDisk: true, speed: 0.00075 };
  group.add(diskBack);

  const diskFront = new THREE.Mesh(
    new THREE.PlaneGeometry(182, 182),
    new THREE.MeshBasicMaterial({
      map: makeBlackHoleDiskTexture(),
      color: 0xffb980,
      transparent: true,
      opacity: 0.44,
      blending: THREE.AdditiveBlending,
      depthWrite: false,
      side: THREE.DoubleSide,
      fog: false,
    })
  );
  diskFront.rotation.x = Math.PI / 2.52;
  diskFront.rotation.z = -0.16;
  diskFront.scale.set(1.0, 0.52, 1.0);
  diskFront.userData = { isAccretionDisk: true, speed: -0.00042 };
  group.add(diskFront);

  const horizon = new THREE.Mesh(
    new THREE.SphereGeometry(28, 72, 72),
    new THREE.MeshBasicMaterial({ color: 0x000000, fog: false })
  );
  group.add(horizon);

  const photonRing = new THREE.Mesh(
    new THREE.RingGeometry(29.8, 34.2, 128),
    new THREE.MeshBasicMaterial({
      color: 0xe8d7cf,
      transparent: true,
      opacity: 0.24,
      side: THREE.DoubleSide,
      blending: THREE.AdditiveBlending,
      depthWrite: false,
      fog: false,
    })
  );
  photonRing.rotation.x = Math.PI / 2;
  group.add(photonRing);

  group.userData = {
    warningRadius: 280,
    triggerRadius: 58,
  };

  scene.add(group);
  blackHole = group;
  return group;
}

function updateBlackHoleEvent() {
  if (!blackHole || blackHoleTriggered) return;

  blackHole.rotation.y += 0.00028;
  blackHole.children.forEach((ch, i) => {
    if (ch.userData?.isAccretionDisk) ch.rotation.z += ch.userData.speed;
    if (ch.material && ch.material.opacity !== undefined && i < 2) {
      ch.material.opacity = (i === 0 ? 0.05 : 0.62) * (0.96 + Math.sin(performance.now() * 0.00035 + i) * 0.04);
    }
  });

  // Important: do not reference local buildScene() variables here.
  if (!blackHoleGameActive) return;

  const distance = camera.position.distanceTo(blackHole.position);
  const warning = document.getElementById('blackhole-warning');
  const distanceLabel = document.getElementById('blackhole-distance');
  const warningRadius = blackHole.userData.warningRadius;
  const triggerRadius = blackHole.userData.triggerRadius;

  const gravityIntensity = distance < warningRadius
    ? 1 - Math.max(0, Math.min(1, (distance - triggerRadius) / (warningRadius - triggerRadius)))
    : 0;

  updateGravityAudio(gravityIntensity);

  const containerEl = document.getElementById('container');
  if (containerEl) containerEl.classList.toggle('grav-distort', gravityIntensity > 0.42);

  if (warning && distance < warningRadius) {
    warning.style.opacity = String(0.28 + gravityIntensity * 0.72);
    warning.style.color = `rgba(255,208,154,${0.35 + gravityIntensity * 0.52})`;
    if (distanceLabel) distanceLabel.textContent = 'DISTANCIA: ' + Math.round(distance) + ' M · EVITAR HORIZONTE DE EVENTOS';
  } else if (warning) {
    warning.style.opacity = '0';
    warning.style.color = 'rgba(255,208,154,0)';
  }

  if (distance < triggerRadius) {
    blackHoleTriggered = true;
    document.exitPointerLock?.();
    const loss = document.getElementById('signal-loss');
    if (loss) loss.classList.add('on');
    setTimeout(() => {
      window.location.href = ROUTE_BASE + '404';
    }, 1700);
  }
}


function createOrbitLine(radius, color = 0x8aa7b8, opacity = 0.13) {
  const pts = [];
  for (let i = 0; i <= 192; i++) {
    const a = (i / 192) * Math.PI * 2;
    pts.push(new THREE.Vector3(Math.cos(a) * radius, 0, Math.sin(a) * radius));
  }
  const line = new THREE.Line(
    new THREE.BufferGeometry().setFromPoints(pts),
    new THREE.LineBasicMaterial({ color, transparent: true, opacity, depthWrite: false })
  );
  return line;
}

// ── BUILD SCENE ────────────────────────────────────────────────────────────
