  solarFlare.scale.set(430, 430, 1);
  scene.add(solarFlare);

  // PLANETS / PROJECTS
  const projects = [
    {
      id:'NGC-001', name:'gaiatools', type:'planeta oceanico', colorHex:'#9ccfff',
