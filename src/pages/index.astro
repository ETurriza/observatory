---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
---
<Layout title="Eduardo Turriza — OBS/1">
  <Nav />

  <!-- HERO -->
  <section class="hero">
    <canvas id="starsCanvas"></canvas>
    <div class="hero-content">
      <p class="coords">RA 19h 24m · DEC +17° 08' · ITAM, Mexico City</p>
      <h1>Eduardo <span>Turriza</span></h1>
      <p class="tagline"><span id="typewriter"></span><span class="cursor">|</span></p>
      <div class="hero-btns">
        <a href="/observatory/objects" class="btn-primary">Explore objects</a>
        <a href="/observatory/log" class="btn-ghost">Read the log</a>
      </div>
    </div>
  </section>

  <!-- COUNTDOWN -->
  <section class="section countdown-section">
    <p class="label">// cuenta regresiva — misión braingeneers</p>
    <div class="cd-grid">
      <div class="cd-unit"><div class="cd-num" id="cdDays">--</div><div class="cd-lbl">días</div></div>
      <div class="cd-unit"><div class="cd-num" id="cdHours">--</div><div class="cd-lbl">horas</div></div>
      <div class="cd-unit"><div class="cd-num" id="cdMins">--</div><div class="cd-lbl">minutos</div></div>
      <div class="cd-unit"><div class="cd-num" id="cdSecs">--</div><div class="cd-lbl">segundos</div></div>
    </div>
    <p class="cd-sub">llegada a <span>UC Santa Cruz · Braingeneers Lab</span> · junio 2026</p>
  </section>

  <div class="divider"></div>

  <!-- ORBIT -->
  <section class="section orbit-section">
    <p class="label">// catálogo de objetos — click para explorar</p>
    <div class="orbit-wrap">
      <svg id="orbitSvg" viewBox="0 0 260 260" width="260" height="260">
        <ellipse cx="130" cy="130" rx="42" ry="22" fill="none" stroke="rgba(255,255,255,0.07)" stroke-width="0.5"/>
        <ellipse cx="130" cy="130" rx="70" ry="38" fill="none" stroke="rgba(255,255,255,0.06)" stroke-width="0.5"/>
        <ellipse cx="130" cy="130" rx="98" ry="54" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="0.5"/>
        <ellipse cx="130" cy="130" rx="120" ry="64" fill="none" stroke="rgba(255,255,255,0.04)" stroke-width="0.5"/>
        <!-- sun -->
        <circle cx="130" cy="130" r="8" fill="#ffb347" opacity="0.9"/>
        <circle cx="130" cy="130" r="14" fill="rgba(255,179,71,0.12)"/>
        <!-- planets -->
        <circle id="p0" r="5.5" fill="#4fc3f7" style="cursor:pointer"/>
        <circle id="p1" r="5" fill="#6ee7b7" style="cursor:pointer"/>
        <circle id="p2" r="5" fill="#c494ff" style="cursor:pointer"/>
      </svg>

      <div class="orbit-info">
        <span class="obj-type" id="objType">nebulosa</span>
        <h2 id="objName">gaiatools</h2>
        <p id="objDesc">Python library para queries y análisis de ESA Gaia DR3. Publicado en PyPI con HDBSCAN clustering y visualizaciones Plotly interactivas.</p>
        <a id="objLink" href="https://github.com/ETurriza/gaiatools" target="_blank" class="obj-link">ver en GitHub →</a>
        <p class="orbit-hint">← los proyectos más recientes orbitan más rápido</p>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- LATEST LOG -->
  <section class="section">
    <p class="label">// bitácora reciente</p>
    <div class="log-list">
      <div class="log-row">
        <span class="log-date">2026-05-04</span>
        <p class="log-text"><strong>Braingeneers ISRP</strong> — Preparando fundamentos: PyTorch con Karpathy, señales neuronales con Neuromatch. Inicio en junio.</p>
      </div>
      <div class="log-row">
        <span class="log-date">2026-03-10</span>
        <p class="log-text"><strong>gaiatools v0.1.0</strong> — Primera versión publicada en PyPI. HDBSCAN, diagramas HR interactivos, crossmatch con NASA Exoplanet Archive.</p>
      </div>
    </div>
    <a href="/observatory/log" class="see-more">ver toda la bitácora →</a>
  </section>
</Layout>

<style>
  /* HERO */
  .hero {
    position: relative;
    height: 420px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  #starsCanvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 0 20px;
  }
  .coords {
    font-family: var(--font-mono);
    font-size: 11px;
    color: rgba(79,195,247,0.6);
    letter-spacing: 0.1em;
    margin-bottom: 16px;
  }
  h1 {
    font-size: clamp(36px, 6vw, 56px);
    font-weight: 500;
    line-height: 1.1;
    margin-bottom: 12px;
  }
  h1 span { color: var(--accent); }
  .tagline {
    font-size: 15px;
    color: var(--text2);
    margin-bottom: 28px;
    font-family: var(--font-mono);
    min-height: 22px;
  }
  .cursor {
    color: var(--accent);
    animation: blink 1s infinite;
  }
  @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0} }
  .hero-btns {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .btn-primary {
    background: var(--accent);
    color: var(--bg);
    padding: 10px 24px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .btn-primary:hover { opacity: 0.85; text-decoration: none; }
  .btn-ghost {
    background: transparent;
    color: var(--text2);
    border: 0.5px solid rgba(255,255,255,0.2);
    padding: 10px 24px;
    border-radius: 6px;
    font-size: 13px;
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s;
  }
  .btn-ghost:hover { border-color: var(--accent); color: var(--accent); text-decoration: none; }

  /* SECTIONS */
  .section { padding: 36px 40px; }
  .divider { height: 0.5px; background: var(--border); margin: 0 40px; }
  .label {
    font-family: var(--font-mono);
    font-size: 10px;
    color: rgba(79,195,247,0.6);
    letter-spacing: 0.14em;
    margin-bottom: 20px;
  }

  /* COUNTDOWN */
  .cd-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    max-width: 480px;
  }
  .cd-unit {
    background: var(--bg3);
    border: 0.5px solid var(--border);
    border-radius: 8px;
    padding: 16px 8px;
    text-align: center;
  }
  .cd-num {
    font-family: var(--font-mono);
    font-size: 28px;
    font-weight: 500;
    color: var(--accent);
    line-height: 1;
  }
  .cd-lbl {
    font-size: 10px;
    color: var(--text3);
    margin-top: 6px;
    letter-spacing: 0.08em;
  }
  .cd-sub {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text3);
    margin-top: 14px;
  }
  .cd-sub span { color: var(--accent); }

  /* ORBIT */
  .orbit-wrap {
    display: flex;
    gap: 40px;
    align-items: center;
    flex-wrap: wrap;
  }
  #orbitSvg { flex-shrink: 0; }
  .orbit-info { flex: 1; min-width: 220px; }
  .obj-type {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 10px;
    padding: 3px 10px;
    border-radius: 10px;
    margin-bottom: 10px;
    background: rgba(79,195,247,0.1);
    color: var(--accent);
    border: 0.5px solid rgba(79,195,247,0.25);
    transition: all 0.3s;
  }
  .orbit-info h2 {
    font-size: 20px;
    font-weight: 500;
    margin-bottom: 8px;
    transition: all 0.3s;
  }
  .orbit-info p {
    font-size: 13px;
    color: var(--text2);
    line-height: 1.7;
    margin-bottom: 12px;
    transition: all 0.3s;
  }
  .obj-link {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent);
    display: block;
    margin-bottom: 16px;
  }
  .orbit-hint {
    font-size: 10px;
    color: var(--text3);
    font-family: var(--font-mono);
  }

  /* LOG */
  .log-list { display: flex; flex-direction: column; gap: 0; }
  .log-row {
    display: flex;
    gap: 20px;
    align-items: flex-start;
    padding: 12px 0;
    border-bottom: 0.5px solid rgba(255,255,255,0.05);
  }
  .log-date {
    font-family: var(--font-mono);
    font-size: 10px;
    color: rgba(79,195,247,0.5);
    min-width: 80px;
    margin-top: 3px;
  }
  .log-text {
    font-size: 13px;
    color: var(--text2);
    line-height: 1.6;
  }
  .log-text strong { color: var(--text); font-weight: 500; }
  .see-more {
    display: inline-block;
    margin-top: 16px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent);
  }

  @media (max-width: 600px) {
    .section { padding: 28px 20px; }
    .divider { margin: 0 20px; }
    .cd-grid { max-width: 100%; }
  }
</style>

<script>
  // STARS PARALLAX
  const canvas = document.getElementById('starsCanvas') as HTMLCanvasElement;
  const hero = canvas.parentElement!;
  const ctx = canvas.getContext('2d')!;
  let W: number, H: number;
  let mouse = { x: 0.5, y: 0.5 };

  const stars = Array.from({ length: 150 }, () => ({
    x: Math.random(),
    y: Math.random(),
    r: Math.random() * 1.3 + 0.2,
    layer: Math.floor(Math.random() * 3),
    opacity: Math.random() * 0.5 + 0.15,
  }));

  function resize() {
    W = canvas.width = hero.offsetWidth;
    H = canvas.height = hero.offsetHeight;
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    const speeds = [6, 14, 28];
    for (const s of stars) {
      const ox = (mouse.x - 0.5) * speeds[s.layer];
      const oy = (mouse.y - 0.5) * speeds[s.layer] * 0.5;
      ctx.beginPath();
      ctx.arc(s.x * W + ox, s.y * H + oy, s.r, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(255,255,255,${s.opacity})`;
      ctx.fill();
    }
    requestAnimationFrame(draw);
  }

  hero.addEventListener('mousemove', e => {
    const r = hero.getBoundingClientRect();
    mouse.x = (e.clientX - r.left) / r.width;
    mouse.y = (e.clientY - r.top) / r.height;
  });

  resize();
  window.addEventListener('resize', resize);
  draw();

  // TYPEWRITER
  const phrases = [
    'computer engineer.',
    'computational astronomer.',
    'bare-metal tinkerer.',
    'deep learning researcher.',
  ];
  let pi = 0, ci = 0, deleting = false;
  const el = document.getElementById('typewriter')!;

  function type() {
    const phrase = phrases[pi];
    if (!deleting) {
      el.textContent = phrase.slice(0, ++ci);
      if (ci === phrase.length) { deleting = true; setTimeout(type, 2000); return; }
      setTimeout(type, 65);
    } else {
      el.textContent = phrase.slice(0, --ci);
      if (ci === 0) { deleting = false; pi = (pi + 1) % phrases.length; setTimeout(type, 300); return; }
      setTimeout(type, 30);
    }
  }
  setTimeout(type, 800);

  // COUNTDOWN
  const target = new Date('2026-06-09T10:00:00');
  function updateCountdown() {
    const diff = target.getTime() - Date.now();
    if (diff <= 0) {
      ['cdDays','cdHours','cdMins','cdSecs'].forEach(id => {
        (document.getElementById(id) as HTMLElement).textContent = '00';
      });
      return;
    }
    const d = Math.floor(diff / 86400000);
    const h = Math.floor((diff % 86400000) / 3600000);
    const m = Math.floor((diff % 3600000) / 60000);
    const s = Math.floor((diff % 60000) / 1000);
    (document.getElementById('cdDays') as HTMLElement).textContent = String(d).padStart(2, '0');
    (document.getElementById('cdHours') as HTMLElement).textContent = String(h).padStart(2, '0');
    (document.getElementById('cdMins') as HTMLElement).textContent = String(m).padStart(2, '0');
    (document.getElementById('cdSecs') as HTMLElement).textContent = String(s).padStart(2, '0');
  }
  updateCountdown();
  setInterval(updateCountdown, 1000);

  // ORBIT
  const projects = [
    { id: 'p0', name: 'gaiatools', type: 'nebulosa', color: '#4fc3f7', bg: 'rgba(79,195,247,0.1)', border: 'rgba(79,195,247,0.25)', desc: 'Python library para queries y análisis de ESA Gaia DR3. Publicado en PyPI con HDBSCAN clustering y visualizaciones Plotly interactivas.', link: 'https://github.com/ETurriza/gaiatools', rx: 42, ry: 22, speed: 0.006, angle: 0 },
    { id: 'p1', name: 'Robot bombero', type: 'satélite', color: '#6ee7b7', bg: 'rgba(110,231,183,0.1)', border: 'rgba(110,231,183,0.25)', desc: 'Máquina de 4 estados en AVR assembly puro para ATmega2560. Detección de llama, seguimiento de línea, identificación de base por color.', link: 'https://github.com/ETurriza', rx: 70, ry: 38, speed: 0.004, angle: 2.5 },
    { id: 'p2', name: 'Braingeneers', type: 'nebulosa en formación', color: '#c494ff', bg: 'rgba(196,148,255,0.1)', border: 'rgba(196,148,255,0.25)', desc: 'Deep learning para caracterización de redes neuronales emergentes usando electrofisiología. UC Santa Cruz · verano 2026.', link: 'https://github.com/braingeneers', rx: 98, ry: 54, speed: 0.018, angle: 0.4 },
  ];

  let selected = 0;
  let paused: number | null = null;

  function setInfo(i: number) {
    const p = projects[i];
    const typeEl = document.getElementById('objType') as HTMLElement;
    typeEl.textContent = p.type;
    typeEl.style.color = p.color;
    typeEl.style.background = p.bg;
    typeEl.style.borderColor = p.border;
    (document.getElementById('objName') as HTMLElement).textContent = p.name;
    (document.getElementById('objDesc') as HTMLElement).textContent = p.desc;
    (document.getElementById('objLink') as HTMLAnchorElement).href = p.link;
    (document.getElementById('objLink') as HTMLAnchorElement).style.color = p.color;
  }

  projects.forEach((p, i) => {
    const el = document.getElementById(p.id)!;
    el.addEventListener('click', () => {
      paused = paused === i ? null : i;
      selected = i;
      setInfo(i);
    });
    el.addEventListener('mouseenter', () => {
      if (paused === null) setInfo(i);
    });
  });

  setInfo(0);

  const svg = document.getElementById('orbitSvg')!;
  const CX = 130, CY = 130;

  function animateOrbit() {
    projects.forEach((p, i) => {
      if (paused !== i) p.angle += p.speed;
      const x = CX + p.rx * Math.cos(p.angle);
      const y = CY + p.ry * Math.sin(p.angle);
      const el = document.getElementById(p.id)!;
      el.setAttribute('cx', x.toFixed(1));
      el.setAttribute('cy', y.toFixed(1));
    });
    requestAnimationFrame(animateOrbit);
  }
  animateOrbit();
</script>
