<script>
import * as THREE from 'three';
import { EffectComposer, RenderPass, BloomEffect, EffectPass, HueSaturationEffect, VignetteEffect, ToneMappingEffect, ToneMappingMode } from 'postprocessing';

const BASE = import.meta.env.BASE_URL + 'textures/';
const ROUTE_BASE = import.meta.env.BASE_URL;

// ── HIGH QUALITY HELPERS ──────────────────────────────────────────────────
function initAudioEngine() {
  if (audioEngine) return audioEngine;

  const Ctx = window.AudioContext || window.webkitAudioContext;
  if (!Ctx) return null;

  const ctx = new Ctx();
  const master = ctx.createGain();
  master.gain.value = 0.0;
  master.connect(ctx.destination);

  const ambient = ctx.createGain();
  ambient.gain.value = 0.055;
  ambient.connect(master);

  const gravity = ctx.createGain();
  gravity.gain.value = 0.0;
  gravity.connect(master);

  const hum = ctx.createOscillator();
  hum.type = 'sine';
  hum.frequency.value = 48;
  hum.connect(ambient);
  hum.start();

  const low = ctx.createOscillator();
  low.type = 'triangle';
  low.frequency.value = 96;
  const lowGain = ctx.createGain();
  lowGain.gain.value = 0.018;
  low.connect(lowGain);
  lowGain.connect(ambient);
  low.start();

  const gravityOsc = ctx.createOscillator();
  gravityOsc.type = 'sawtooth';
  gravityOsc.frequency.value = 34;
  const gravityFilter = ctx.createBiquadFilter();
  gravityFilter.type = 'lowpass';
  gravityFilter.frequency.value = 180;
  gravityOsc.connect(gravityFilter);
  gravityFilter.connect(gravity);
  gravityOsc.start();

  audioEngine = { ctx, master, ambient, gravity, hum, low, gravityOsc, gravityFilter };
  return audioEngine;
}

function setAudioEnabled(enabled) {
  const engine = initAudioEngine();
  if (!engine) return;

  if (engine.ctx.state === 'suspended') engine.ctx.resume();

  audioEnabled = enabled;
  const now = engine.ctx.currentTime;
  engine.master.gain.cancelScheduledValues(now);
  engine.master.gain.linearRampToValueAtTime(enabled ? 0.38 : 0.0, now + 0.55);

  const btn = document.getElementById('audio-btn');
  if (btn) btn.textContent = enabled ? 'AUDIO ON' : 'AUDIO OFF';
}

function playDiscoverySound() {
  const engine = initAudioEngine();
  if (!engine || !audioEnabled) return;

  const ctx = engine.ctx;
  const now = ctx.currentTime;

  const osc = ctx.createOscillator();
  const gain = ctx.createGain();
  const filter = ctx.createBiquadFilter();

  osc.type = 'sine';
  osc.frequency.setValueAtTime(880, now);
  osc.frequency.exponentialRampToValueAtTime(1320, now + 0.11);

  filter.type = 'bandpass';
  filter.frequency.value = 1100;
  filter.Q.value = 8;

  gain.gain.setValueAtTime(0.0, now);
  gain.gain.linearRampToValueAtTime(0.11, now + 0.018);
  gain.gain.exponentialRampToValueAtTime(0.001, now + 0.32);

  osc.connect(filter);
  filter.connect(gain);
  gain.connect(engine.master);

  osc.start(now);
  osc.stop(now + 0.35);
}

function playTourStepSound() {
  const engine = initAudioEngine();
  if (!engine || !audioEnabled) return;

  const ctx = engine.ctx;
  const now = ctx.currentTime;
  const osc = ctx.createOscillator();
  const gain = ctx.createGain();

  osc.type = 'triangle';
  osc.frequency.setValueAtTime(330, now);
  osc.frequency.exponentialRampToValueAtTime(495, now + 0.18);

  gain.gain.setValueAtTime(0.0, now);
  gain.gain.linearRampToValueAtTime(0.065, now + 0.03);
  gain.gain.exponentialRampToValueAtTime(0.001, now + 0.42);

  osc.connect(gain);
  gain.connect(engine.master);
  osc.start(now);
  osc.stop(now + 0.44);
}

function updateGravityAudio(intensity) {
  const engine = initAudioEngine();
  if (!engine || !audioEnabled) return;

  const now = engine.ctx.currentTime;
  const target = Math.max(0, Math.min(1, intensity));
  engine.gravity.gain.cancelScheduledValues(now);
  engine.gravity.gain.linearRampToValueAtTime(0.11 * target, now + 0.12);
  engine.gravityOsc.frequency.setTargetAtTime(34 + target * 18, now, 0.12);
  engine.gravityFilter.frequency.setTargetAtTime(180 + target * 260, now, 0.12);
}


function setSRGB(tex) {
  if (!tex) return tex;
  if ('colorSpace' in tex && THREE.SRGBColorSpace) tex.colorSpace = THREE.SRGBColorSpace;
  else tex.encoding = THREE.sRGBEncoding;
  tex.anisotropy = Math.min(renderer?.capabilities?.getMaxAnisotropy?.() || 8, 16);
  tex.generateMipmaps = true;
  tex.minFilter = THREE.LinearMipmapLinearFilter;
  tex.magFilter = THREE.LinearFilter;
  return tex;
}

function makeRadialSprite(size = 128, inner = 'rgba(255,255,255,1)', mid = 'rgba(255,255,255,.55)', outer = 'rgba(255,255,255,0)') {
  const c = document.createElement('canvas');
  c.width = c.height = size;
  const ctx = c.getContext('2d');
  const r = size * 0.5;
  const g = ctx.createRadialGradient(r, r, 0, r, r, r);
  g.addColorStop(0, inner);
  g.addColorStop(0.34, mid);
  g.addColorStop(1, outer);
  ctx.fillStyle = g;
  ctx.fillRect(0,0,size,size);
  const tex = new THREE.CanvasTexture(c);
  if ('colorSpace' in tex && THREE.SRGBColorSpace) tex.colorSpace = THREE.SRGBColorSpace;
  return tex;
}

const starSprite = makeRadialSprite(96, 'rgba(255,255,255,1)', 'rgba(255,255,255,.42)', 'rgba(255,255,255,0)');
const dustSprite = makeRadialSprite(128, 'rgba(255,255,255,.8)', 'rgba(255,255,255,.14)', 'rgba(255,255,255,0)');
const flareSprite = makeRadialSprite(192, 'rgba(255,246,218,1)', 'rgba(255,192,104,.25)', 'rgba(255,160,80,0)');

// ── ATMOSPHERE SHADERS: thin physically inspired limb scattering ──────────
const atmoVert = `
  varying vec3 vWorldNormal;
  varying vec3 vViewDir;
  varying vec3 vWorldPos;
  void main() {
    vec4 worldPos = modelMatrix * vec4(position, 1.0);
    vWorldPos = worldPos.xyz;
    vWorldNormal = normalize(mat3(modelMatrix) * normal);
    vViewDir = normalize(cameraPosition - worldPos.xyz);
    gl_Position = projectionMatrix * viewMatrix * worldPos;
  }
`;

const atmoFrag = `
  uniform vec3 uColor;
  uniform vec3 uSunDir;
  uniform float uOpacity;
  uniform float uPower;
  uniform float uDayBoost;
  varying vec3 vWorldNormal;
  varying vec3 vViewDir;
  varying vec3 vWorldPos;

  void main() {
    vec3 N = normalize(vWorldNormal);
    vec3 V = normalize(vViewDir);
    vec3 L = normalize(uSunDir);

    float rim = pow(1.0 - clamp(dot(N, V), 0.0, 1.0), uPower);
    float sunSide = clamp(dot(N, L) * 0.5 + 0.5, 0.0, 1.0);
    float forwardScatter = pow(sunSide, 2.2) * uDayBoost;
    float terminator = smoothstep(0.12, 0.92, sunSide);

    vec3 deep = uColor * 0.28;
    vec3 lit  = uColor * (0.78 + forwardScatter);
    vec3 col = mix(deep, lit, terminator);

    float alpha = rim * (0.25 + 0.75 * terminator) * uOpacity;
    gl_FragColor = vec4(col, alpha);
  }
`;

const terminatorVert = `
  varying vec3 vWorldNormal;
  void main() {
    vWorldNormal = normalize(mat3(modelMatrix) * normal);
    gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
  }
`;


const sunVert = `
  varying vec2 vUv;
  varying vec3 vNormalView;
  void main() {
    vUv = uv;
    vNormalView = normalize(normalMatrix * normal);
    gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
  }
`;

const sunFrag = `
  uniform float uTime;
  varying vec2 vUv;
  varying vec3 vNormalView;

  float hash(vec2 p) {
    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);
  }

  float noise(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    vec2 u = f * f * (3.0 - 2.0 * f);
    float a = hash(i);
    float b = hash(i + vec2(1.0, 0.0));
    float c = hash(i + vec2(0.0, 1.0));
    float d = hash(i + vec2(1.0, 1.0));
    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
  }

  float fbm(vec2 p) {
    float v = 0.0;
    float a = 0.55;
    for (int i = 0; i < 5; i++) {
      v += a * noise(p);
      p *= 2.05;
      a *= 0.52;
    }
    return v;
  }

  void main() {
    vec2 uv = vUv;
    vec2 p = uv * 7.2;

    float plasma = fbm(p + vec2(uTime * 0.025, -uTime * 0.018));
    float cells = fbm(p * 2.35 + vec2(-uTime * 0.032, uTime * 0.021));
    float detail = fbm(p * 5.5 + vec2(uTime * 0.016));

    float limb = abs(vNormalView.z);
    limb = pow(clamp(limb, 0.0, 1.0), 0.18);

    vec3 orangeDeep = vec3(1.0, 0.25, 0.03);
    vec3 orange = vec3(1.0, 0.48, 0.08);
    vec3 gold = vec3(1.0, 0.78, 0.24);
    vec3 whiteHot = vec3(1.0, 0.96, 0.68);

    float heat = plasma * 0.72 + cells * 0.34 + detail * 0.12;

    vec3 col = mix(orangeDeep, orange, smoothstep(0.22, 0.78, heat));
    col = mix(col, gold, smoothstep(0.52, 0.92, heat) * 0.72);
    col = mix(col, whiteHot, smoothstep(0.82, 1.08, heat) * 0.55);

    // Mantiene el borde luminoso, no oscuro, para que nunca parezca planeta.
    col *= 0.92 + limb * 0.55;

    gl_FragColor = vec4(col, 1.0);
  }
`;

const terminatorFrag = `
  uniform vec3 uSunDir;
  uniform float uStrength;
  varying vec3 vWorldNormal;
  void main() {
    float d = dot(normalize(vWorldNormal), normalize(uSunDir));
    float shade = smoothstep(0.34, -0.25, d) * uStrength;
    gl_FragColor = vec4(0.0, 0.0, 0.02, shade);
  }
`;

